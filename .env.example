# 仅用于本地开发演示。不要把本文件原样用作预发布或生产环境配置。
NODE_ENV=development
PORT=3001
# production 必须填写直接连接 API 的受信任反向代理 IP/CIDR，逗号分隔；
# 禁止使用 0.0.0.0/0、::/0、* 或直接信任任意 X-Forwarded-For。
TRUSTED_PROXY_CIDRS=
# Next.js 管理台分别访问公开只读 API 与独立管理员 API；容器环境分别使用
# http://api:3001 和 http://admin-api:3002。浏览器不能直连管理员 API。
PUBLIC_API_BASE_URL=http://localhost:3001
ADMIN_API_BASE_URL=http://127.0.0.1:3002

# 管理员 API 默认关闭，且只能使用独立 admin_api_runtime 连接池。启用时下列
# ADMIN_* 项必须通过部署 Secret 显式注入；不得复用 DATABASE_URL、普通用户 token、
# 普通 API 角色，也不得把管理员数据库密码硬编码进 Compose/镜像。密钥格式为 version:base64，
# 每枚密钥必须恰好 32 字节，当前版本在首位，最多保留 3 个轮换版本。
ADMIN_API_ENABLED=false
ADMIN_PORT=3002
# development/test 默认回环；production 必须显式设置为私有网络监听地址。
ADMIN_BIND_HOST=127.0.0.1
# production 必填，只允许同源 Next BFF 的源 IP/CIDR，禁止 /0。管理员 API 仅在
# 该受信代理链下接受 BFF 规范化的单一 X-Forwarded-For。
ADMIN_TRUSTED_PROXY_CIDRS=
ADMIN_DATABASE_URL=
ADMIN_DATABASE_EXPECTED_TARGET=
ADMIN_DATABASE_RUNTIME_ROLE_NAME=admin_api_runtime
ADMIN_DATABASE_SSL_MODE=verify-full
# 可选 Base64 PEM CA；留空时使用 Node 系统信任根，仍强制证书与主机名校验。
ADMIN_DATABASE_SSL_CA_BASE64=
ADMIN_DATABASE_POOL_MAX=4
ADMIN_DATABASE_CONNECT_TIMEOUT_MS=5000
ADMIN_DATABASE_IDLE_TIMEOUT_MS=15000
ADMIN_WEBAUTHN_RP_NAME=吃什么管理后台
ADMIN_WEBAUTHN_RP_ID=
# 逗号分隔的精确 HTTPS Origin；生产禁止 localhost、IP、路径、查询或片段。
ADMIN_WEBAUTHN_ORIGINS=
ADMIN_HMAC_KEYS=
ADMIN_CREDENTIAL_ENCRYPTION_KEYS=

# 开发/测试默认关闭数据库且绝不建立连接。production 不允许关闭，必须使用
# postgresql:// URL，并把 TLS 模式设为 verify-full；URL 禁止携带 sslmode/query。
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_SSL_MODE=disable
# 可选：Base64 编码的 PEM CA；verify-full 未填写时使用 Node 系统信任根。
DATABASE_SSL_CA_BASE64=
# 非秘密部署身份；production 的 API、迁移、维护和数据导出 worker 各自
# 核对目标与角色，互不接收其他角色密码。管理员 API 另用 ADMIN_* 边界。
DATABASE_EXPECTED_TARGET=
DATABASE_RUNTIME_ROLE_NAME=
DATABASE_MIGRATION_ROLE_NAME=
DATABASE_MAINTENANCE_ROLE_NAME=
DATABASE_EXPORT_WORKER_ROLE_NAME=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# 生产迁移和保留期清理必须使用与 API 不同的最小权限角色，且指向同一数据库。
# 迁移不会随 API 自动运行；先显式执行 pnpm db:migrate。
DATABASE_MIGRATION_URL=
DATABASE_MIGRATION_SSL_MODE=disable
DATABASE_MIGRATION_SSL_CA_BASE64=
DATABASE_MAINTENANCE_URL=
DATABASE_MAINTENANCE_SSL_MODE=disable
DATABASE_MAINTENANCE_SSL_CA_BASE64=
DATABASE_EXPORT_WORKER_URL=
DATABASE_EXPORT_WORKER_SSL_MODE=disable
DATABASE_EXPORT_WORKER_SSL_CA_BASE64=

DATA_RIGHTS_MODE=LIVE_DISPLAY_ONLY
# 只有切换 LICENSED_ENRICHMENT 时才填写。ID 必须是数据库授权记录的规范 UUID，
# 到期时间使用未来的 ISO 8601 时间。服务会逐供应商/逐 operation 查询数据库，
# 任一缺失、撤销、过期、供应商不符或数据库不可用都会降为 LIVE_DISPLAY_ONLY；
# 这些工程门禁仍不能代替书面授权和法务确认。
DATA_RIGHTS_AUTHORIZATION_ID=
DATA_RIGHTS_AUTHORIZATION_EXPIRES_AT=
# 仅 development/test 可开启；production 必须显式设为 false，否则服务拒绝启动。
ALLOW_DEMO_DATA=true
# 三条能力链路独立排序；只允许当前构建已注册的代码。disabled 来源会跳过，
# 列表为空、重复、含空项或未知代码时 API 拒绝启动。
RECOMMENDATION_PROVIDER_PRIORITY=AMAP,DEMO
LOCATION_SEARCH_PROVIDER_PRIORITY=AMAP,DEMO
PLACE_SEARCH_PROVIDER_PRIORITY=AMAP,DEMO
PROMPT_VERSION=intent-prompt-v1
MINIMUM_SUPPORTED_VERSION=0.1.0
ACCOUNTS_ENABLED=false
FAVORITES_ENABLED=false
HISTORY_ENABLED=false
PRIVATE_FEEDBACK_ENABLED=false

# 产品反馈/餐厅纠错默认关闭。启用时需要 PostgreSQL，以及用途完全分离的
# AES-256-GCM 加密密钥环和 HMAC-SHA256 指纹密钥环。JSON 值是规范 Base64
# 32 字节密钥；每个密钥环最多保留 3 个版本，旧版本须等启动覆盖门禁允许后再移除。
# HMAC 轮换时所有实例必须同时携带当前版和仍被数据库引用的候选版；游客 IP
# HMAC 不可重算，只能在 24 小时配额窗结束并由维护任务销毁后清退旧版。
SUPPORT_FEEDBACK_ENABLED=false
SUPPORT_FEEDBACK_ENCRYPTION_ACTIVE_VERSION=
SUPPORT_FEEDBACK_ENCRYPTION_KEYS_JSON=
SUPPORT_FEEDBACK_HMAC_ACTIVE_VERSION=
SUPPORT_FEEDBACK_HMAC_KEYS_JSON=

# 账号数据导出默认关闭。启用时 API 只读取私有 OSS 对象，独立 worker 只负责
# 生成/覆盖/删除；两者应使用不同的最小权限 RAM 角色。locator 密钥仅用于
# 加密 App 自有 object key，最多保留三版。最终 JSON 固定不超过 10 MiB。
# worker 只接收下方 locator 密钥与 SUPPORT_FEEDBACK_ENCRYPTION_*，不得接收
# AUTH_*、SUPPORT_FEEDBACK_HMAC_*、OAuth、短信、管理员或高德 Secret。
DATA_EXPORT_ENABLED=false
# 仅在独立 worker、数据库角色、OSS RAM 策略与告警都已部署并通过探针后设 true；
# false 时 API 不宣传能力，也不接受排队、状态或下载请求。
DATA_EXPORT_WORKER_READY=false
DATA_EXPORT_OSS_REGION=oss-cn-beijing
DATA_EXPORT_OSS_BUCKET=
DATA_EXPORT_OSS_INTERNAL=true
DATA_EXPORT_OSS_TIMEOUT_MS=10000
DATA_EXPORT_CREDENTIAL_TIMEOUT_MS=3000
DATA_EXPORT_MAX_ARTIFACT_BYTES=10485760
# API-only：绝对期限覆盖数据库/OSS 预取与 HTTP 传输，空闲期限限制滴速客户端。
# worker 严格环境白名单不得注入这两个变量。
DATA_EXPORT_DOWNLOAD_TOTAL_TIMEOUT_MS=120000
DATA_EXPORT_DOWNLOAD_IDLE_TIMEOUT_MS=15000
DATA_EXPORT_LOCATOR_ACTIVE_VERSION=
DATA_EXPORT_LOCATOR_KEYS_JSON=
DATA_EXPORT_WORKER_LEASE_SECONDS=180
DATA_EXPORT_WORKER_POLL_INTERVAL_MS=1000

# 高德仅在获得并确认适用授权后启用。服务端 Web Service Key 不得放进 Android 客户端。
# 生产还必须在控制台绑定出口 IP 白名单并开启数字签名；签名私钥同样只由
# 服务端 Secret 注入。下面的确认值是生产启动硬门禁，不会代替实际控制台配置。
AMAP_ENABLED=false
# 已获授权的手机本地收集：3.5km、最多2页、每次启动独立文件、90天。
# 独立于推荐增强/服务端收藏权利；关闭后客户端不启动自动收集。
NEARBY_RESTAURANT_COLLECTION_ENABLED=true
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_SIGNATURE_PRIVATE_KEY=
AMAP_IP_WHITELIST_CONFIGURED=false
AMAP_TIMEOUT_MS=2200

# 北京地域百炼工作空间专属地址，例如：
# https://{workspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ENABLED=false
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_TIMEOUT_MS=2500

# 账号与身份能力默认全部关闭。启用账号时必须开启 PHONE_AUTH_ENABLED，并让
# 数据库、认证 hash ring 和阿里云号码认证“短信认证服务”通过启动门禁。产品策略
# 固定为 PHONE_ONLY：手机号验证码可直接注册或登录；微信、QQ、邮箱仅登录已绑定
# 账号，不会独立创建账号。以下均为服务端变量，禁止进入 APK。
# legacy_phone_drain 只属于 0010→0011 的旧停号桥；
# wechat_union_aliases_pending 只用于 0011→0012 且必须关闭微信通道。
AUTH_SCHEMA_TRANSITION_MODE=none
PHONE_AUTH_ENABLED=false
EMAIL_AUTH_ENABLED=false
WECHAT_AUTH_ENABLED=false
QQ_AUTH_ENABLED=false
QQ_UNION_ID_ENABLED=false
# 生产 --disable 只关开关；已生成的主 HMAC/dedup 与 OTP pepper 连续性值必须继续
# 保存在 root-only api.env，重新 --apply 时不得换 key/version。
AUTH_HASH_ACTIVE_VERSION=
AUTH_HASH_KEYS_JSON=
# AUTH_IDENTITY_DEDUP_KEY_VERSION 只能引用 ring 内稳定版本。
AUTH_OTP_PEPPER_ACTIVE_VERSION=
AUTH_OTP_PEPPER_KEYS_JSON=
AUTH_IDENTITY_DEDUP_KEY_VERSION=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OAUTH_STATE_TTL_SECONDS=600

# 官方 @alicloud/credentials 默认凭据链。生产 ECS 优先绑定最小权限实例 RAM
# 角色并填写角色名，且强制 IMDSv2；无需在仓库、镜像或客户端保存长期 AK。
# 本示例不包含任何 AccessKey。开发环境如必须使用 AK，只通过外部 Secret
# 注入 ALIBABA_CLOUD_ACCESS_KEY_ID/ALIBABA_CLOUD_ACCESS_KEY_SECRET，切勿写入文件。
ALIBABA_CLOUD_ECS_METADATA=
ALIBABA_CLOUD_IMDSV1_DISABLED=true
ALIBABA_CLOUD_ECS_IMDSV2_ENABLE=true
ALIBABA_CLOUD_ECS_METADATA_DISABLED=false
ALIYUN_CREDENTIAL_TIMEOUT_MS=2000
ALIYUN_CREDENTIAL_ALLOWED_PROVIDER=default/ecs_ram_role

# 阿里云号码认证服务的“短信认证服务”（Dypnsapi），不是短信服务 SendSms。
# 签名和模板必须来自该产品并已可用；服务端固定 ReturnVerifyCode=false，使用
# SendSmsVerifyCode + CheckSmsVerifyCode，Android 不接入任何号码认证 SDK。
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_TIMEOUT_MS=1500

# 通用 SMTP 邮件验证码。465 使用隐式 TLS；587/25 必须把 SMTP_SECURE 设为
# false，服务端仍会强制 STARTTLS。SMTP_PASSWORD 必须是邮箱服务商签发的
# SMTP 专用密码/授权码，不得填写邮箱网页登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=
SMTP_FROM_NAME=吃什么
SMTP_TIMEOUT_MS=5000

# 仅 WECHAT_AUTH_ENABLED=true 时填写；关闭时可省略，运行进程不会注入 AppSecret。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 同一微信开放平台账号下的 App/小程序必须永久复用同一个小写内部 realm。
WECHAT_OPEN_PLATFORM_REALM_ID=eatwhat-primary
WECHAT_AUTH_TIMEOUT_MS=2000
# 小程序独立 code2Session 通道；只登录同一开放平台 UnionID 已关联的账号。
# 必须先完成 schema 0014 与最小权限验收，AppSecret 仅留在服务端。
WECHAT_MINIPROGRAM_AUTH_ENABLED=false
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_AUTH_TIMEOUT_MS=2000
QQ_APP_ID=
# Server-Side 登录换票专用 AppKey；只允许服务端私有环境，禁止进入 Android/APK。
QQ_APP_KEY=
# 仅 QQ_UNION_ID_ENABLED=true 时使用；同一 QQ 互联开放平台打通应用集合必须永久复用。
QQ_OPEN_PLATFORM_REALM_ID=eatwhat-qq-primary
QQ_AUTH_TIMEOUT_MS=2000
