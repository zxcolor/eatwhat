# 复制为 .env.local 后仅在本机填写。该模板只属于公开 API 进程；不要加入
# ADMIN_*、DATABASE_MIGRATION_*、DATABASE_MAINTENANCE_* 或导出 worker Secret。
NODE_ENV=development
PORT=3001
TRUSTED_PROXY_CIDRS=
ADMIN_API_BASE_URL=http://127.0.0.1:3002

# 登录主线需要 API runtime 数据库连接；账号关闭时保持全部空值和 false。
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_BASE64=
DATABASE_EXPECTED_TARGET=
DATABASE_RUNTIME_ROLE_NAME=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

DATA_RIGHTS_MODE=LIVE_DISPLAY_ONLY
DATA_RIGHTS_AUTHORIZATION_ID=
DATA_RIGHTS_AUTHORIZATION_EXPIRES_AT=
ALLOW_DEMO_DATA=true
RECOMMENDATION_PROVIDER_PRIORITY=AMAP,DEMO
LOCATION_SEARCH_PROVIDER_PRIORITY=AMAP,DEMO
PLACE_SEARCH_PROVIDER_PRIORITY=AMAP,DEMO
RULE_VERSION=recommendation-rules-v1
PROMPT_VERSION=intent-prompt-v1
MINIMUM_SUPPORTED_VERSION=0.1.0
ACCOUNTS_ENABLED=false
FAVORITES_ENABLED=false
DATA_EXPORT_DOWNLOAD_TOTAL_TIMEOUT_MS=120000
DATA_EXPORT_DOWNLOAD_IDLE_TIMEOUT_MS=15000

# 高德 Web Service Key 只写入未跟踪的 .env.local，绝不写入 Android 或聊天。
# 真实 Key smoke 还必须由 run-amap-live-smoke.ps1 的 -ConfirmLiveRequest
# 二次确认；默认测试与 verify.ps1 永远不会读取此开关或发起真实高德请求。
AMAP_LIVE_SMOKE_ENABLED=false
AMAP_ENABLED=false
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_SIGNATURE_PRIVATE_KEY=
AMAP_IP_WHITELIST_CONFIGURED=false
AMAP_TIMEOUT_MS=2200

# 保留现有千问配置能力；本轮登录/高德开发不启用或扩展它。
QWEN_ENABLED=false
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash-2026-07-15
QWEN_TIMEOUT_MS=2500

# 账号服务只有在 runtime 数据库、认证 hash ring 和阿里云短信认证就绪后才能
# 开启。产品注册策略固定为 PHONE_ONLY：手机号验证码可直接注册或登录；微信、
# QQ、邮箱只登录已绑定账号，不会独立创建账号。
# legacy_phone_drain 只用于旧 0010→0011 停号桥；wechat_union_aliases_pending
# 只用于 0011→0012，且必须保持 WECHAT_AUTH_ENABLED=false。
AUTH_SCHEMA_TRANSITION_MODE=none
PHONE_AUTH_ENABLED=false
EMAIL_AUTH_ENABLED=false
WECHAT_AUTH_ENABLED=false
QQ_AUTH_ENABLED=false
QQ_UNION_ID_ENABLED=false
# 生产 --disable 后仍须保留主 HMAC/dedup 与已有 OTP pepper；它是可逆停号，不是重置。
AUTH_HASH_ACTIVE_VERSION=
AUTH_HASH_KEYS_JSON=
AUTH_OTP_PEPPER_ACTIVE_VERSION=
AUTH_OTP_PEPPER_KEYS_JSON=
AUTH_IDENTITY_DEDUP_KEY_VERSION=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OAUTH_STATE_TTL_SECONDS=600

# 官方阿里云默认凭据链。长期 AccessKey 不得写入此文件；开发时也应由外部
# Secret 注入，生产优先使用最小权限 ECS RAM 角色和 IMDSv2。
ALIBABA_CLOUD_ECS_METADATA=
ALIBABA_CLOUD_IMDSV1_DISABLED=true
ALIBABA_CLOUD_ECS_IMDSV2_ENABLE=true
ALIBABA_CLOUD_ECS_METADATA_DISABLED=true
ALIYUN_CREDENTIAL_TIMEOUT_MS=2000
ALIYUN_CREDENTIAL_ALLOWED_PROVIDER=default/env
# 使用号码认证服务的纯服务端“短信认证服务”，不要混用短信服务 SendSms。
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_TIMEOUT_MS=1500
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=
SMTP_FROM_NAME=吃什么
SMTP_TIMEOUT_MS=5000
# 仅 WECHAT_AUTH_ENABLED=true 时填写；关闭时本机启动器不会注入 AppSecret。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OPEN_PLATFORM_REALM_ID=eatwhat-primary
WECHAT_AUTH_TIMEOUT_MS=2000
QQ_APP_ID=
# 仅服务端 Server-Side 换票使用；不得写入任何 Android 构建属性。
QQ_APP_KEY=
QQ_OPEN_PLATFORM_REALM_ID=eatwhat-qq-primary
QQ_AUTH_TIMEOUT_MS=2000
