@import "styles/liquid-glass.wxss";

page { background:#edf3f5; color:#1C1C1E; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC',sans-serif; font-size:16px; }
view, button, input, text, scroll-view { box-sizing:border-box; }
button { font-size:16px; line-height:1.5; border-radius:20px; margin:0; transition:transform 150ms cubic-bezier(.23,1,.32,1),background-color 220ms ease; }
button:active { transform:scale(.98); }
button::after { border:0; }
.page, .shell { --bg:#F7F6F2; --card:#fff; --text:#1C1C1E; --muted:#79766f; --accent:#b94a29; --soft:#efede6; --line:#e7e4db; --accent-soft:#fbefe8; --success:#3f7961; --success-soft:#e7f2ec; --ease-out:cubic-bezier(.23,1,.32,1); --ease-drawer:cubic-bezier(.32,.72,0,1); min-height:100vh; background:var(--bg); color:var(--text); }
.theme-dark { --bg:#211d19; --card:#2d2721; --text:#f6eadd; --muted:#c2ad96; --accent:#efaa7c; --soft:#403327; --line:#5b4937; --accent-soft:#483227; }
.page { padding:24px 18px calc(28px + env(safe-area-inset-bottom)); }
.title { font-size:28px; font-weight:700; line-height:1.35; margin-bottom:12px; }
.subtitle, .muted { color:var(--muted); font-size:14px; line-height:1.65; }
.card { background:var(--card); border:1px solid var(--line); border-radius:24px; padding:20px; margin-bottom:14px; box-shadow:0 3px 16px rgba(28,28,30,.025); }
.row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.label { font-size:16px; font-weight:600; line-height:1.5; }
.primary, .secondary { min-height:52px; padding:14px 18px; margin-top:14px; font-weight:600; text-align:center; }
button.primary, button.secondary { width:100%; }
.primary { background:var(--accent); color:#fff; border-radius:28px; }
.theme-dark .primary { color:#352c28; }
.secondary { background:var(--soft); color:var(--text); border:1px solid var(--line); }
button[disabled], button.primary[disabled], button.secondary[disabled], button.chip[disabled] { opacity:.6; color:var(--muted); background:var(--soft); }
.error { padding:14px 16px; border-radius:14px; background:var(--accent-soft); color:var(--text); margin:12px 0; font-size:14px; line-height:1.6; }
.chips { display:flex; gap:8px; flex-wrap:wrap; margin:12px 0; }
.chip { min-height:44px; padding:10px 14px; border:1px solid transparent; border-radius:12px; background:var(--soft); color:var(--text); font-size:14px; }
button.chip { width:auto; flex:0 0 auto; margin:0; }
.chip.selected { background:var(--accent-soft); color:var(--accent); border-color:var(--accent); font-weight:600; }
.field { background:var(--soft); padding:13px 15px; height:50px; border-radius:12px; color:var(--text); margin:10px 0; }
.section-title { font-size:17px; font-weight:600; margin:22px 0 12px; }
.empty { text-align:center; padding:35px 15px; color:var(--muted); line-height:1.75; }
.link { color:var(--accent); }
@media (prefers-reduced-motion:reduce) { button { transition:none; } button:active { transform:none; } }
