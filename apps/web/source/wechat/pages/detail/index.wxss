.restaurant-detail { padding:26px 20px calc(142px + env(safe-area-inset-bottom)); }
.choice-summary { padding:12px 12px 23px; border-radius:32px; }
.restaurant-image-area { position:relative; height:220px; margin-bottom:21px; overflow:hidden; border-radius:23px; background:var(--soft); }
.restaurant-image-area::after { content:''; position:absolute; inset:0; border:1px solid rgba(255,255,255,.25); border-radius:inherit; pointer-events:none; }
.restaurant-image { display:block; width:100%; height:100%; }
.restaurant-image-placeholder { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:var(--muted); font-size:12px; line-height:1.8; }
.restaurant-mark { display:flex; align-items:center; justify-content:center; width:60px; height:60px; margin-bottom:14px; border:1px solid var(--line); border-radius:20px; background:var(--glass-control-fill); color:var(--muted); font-size:27px; }
.summary-copy { padding:0 11px; }
.result-name { font-size:30px; font-weight:650; line-height:1.38; letter-spacing:-.6px; overflow-wrap:anywhere; }
.source { margin-top:9px; color:var(--muted); font-size:12px; line-height:1.85; overflow-wrap:anywhere; }
.facts-row { display:flex; gap:15px; margin-top:20px; padding:16px; border-radius:20px; }
.fact { flex:1; min-width:0; }
.fact + .fact { padding-left:15px; border-left:1px solid var(--line); }
.fact-label { margin-bottom:6px; color:var(--muted); font-size:12px; font-weight:600; line-height:18px; letter-spacing:.2px; }
.price,.distance { font-size:19px; font-weight:650; line-height:1.5; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }
.reference-note { margin-top:13px; color:var(--muted); font-size:12px; line-height:1.85; }
.information-section { margin-top:16px; padding:23px 22px; border-radius:28px; }
.section-title { margin:0 0 14px; font-size:17px; font-weight:650; line-height:1.5; }
.information-row { display:flex; align-items:flex-start; gap:18px; padding:12px 0; color:var(--text); font-size:13px; line-height:1.85; }
.information-row + .information-row { border-top:1px solid var(--line); }
.information-label { flex:0 0 30px; width:30px; color:var(--muted); font-size:12px; }
.information-row > text:last-child { flex:1; min-width:0; overflow-wrap:anywhere; word-break:break-all; }
.restaurant-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:14px; }
.tag { max-width:100%; padding:5px 9px; border:1px solid var(--line); border-radius:9px; color:var(--muted); font-size:12px; line-height:1.7; overflow-wrap:anywhere; }
.action-row { display:flex; flex-wrap:wrap; gap:10px; margin-top:4px; }
.action-row .secondary { flex:1 1 120px; width:auto; min-width:0; padding:12px 8px; font-size:13px; line-height:1.8; }
.note,.reason { margin-top:12px; color:var(--muted); font-size:12px; line-height:1.9; overflow-wrap:anywhere; }
.reason { color:var(--text); font-size:13px; }
.feedback-options { display:flex; flex-wrap:wrap; gap:8px; margin-top:15px; }
.feedback-options .chip { max-width:100%; white-space:normal; line-height:1.8; }
.saved-link { min-height:44px; margin-top:8px; padding:11px 0; border-radius:12px; background:transparent; color:var(--accent); font-size:12px; font-weight:600; line-height:22px; text-align:left; }
.page.glass-page .detail-actions { position:fixed; left:16px; right:16px; bottom:calc(12px + env(safe-area-inset-bottom)); z-index:20; display:flex; align-items:stretch; gap:10px; max-width:680px; margin:0 auto; padding:10px; border-radius:30px; }
.detail-actions .primary,.detail-actions .secondary { width:auto; min-height:54px; margin:0; padding:14px 16px; border-radius:23px; font-size:16px; line-height:1.6; }
.detail-actions .primary { flex:1; min-width:0; }
.detail-actions .secondary { flex:0 0 92px; width:92px; }
.detail-empty { margin-top:20px; padding:40px 24px 30px; border-radius:32px; text-align:center; }
.empty-mark { display:flex; align-items:center; justify-content:center; width:70px; height:70px; margin:0 auto 22px; border:1px solid var(--line); border-radius:24px; background:var(--soft); color:var(--muted); font-size:31px; }
.empty-title { font-size:24px; font-weight:650; line-height:1.45; letter-spacing:-.3px; }
.empty-copy { margin-top:14px; color:var(--muted); font-size:13px; line-height:1.85; }
.detail-empty .primary { margin-top:28px; }
.inapp-route-action { margin:20px 0 14px; min-height:54px; }
.reduced-motion button { transition:none; }
.reduced-motion button:active { transform:none; }
@media (max-width:350px) {
  .restaurant-detail { padding-left:16px; padding-right:16px; }
  .choice-summary { padding:10px 10px 20px; border-radius:28px; }
  .restaurant-image-area { height:190px; border-radius:20px; }
  .summary-copy { padding:0 8px; }
  .result-name { font-size:27px; }
  .facts-row { gap:12px; padding:14px 12px; }
  .fact + .fact { padding-left:12px; }
  .price,.distance { font-size:17px; }
  .information-section { padding:21px 19px; }
  .page.glass-page .detail-actions { left:12px; right:12px; }
  .detail-actions .secondary { flex-basis:80px; width:80px; }
}
