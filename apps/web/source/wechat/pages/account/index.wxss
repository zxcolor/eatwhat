.account-heading { display: flex; align-items: center; gap: 24rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 30rpx; color: var(--accent); background: var(--accent-soft); font-size: 40rpx; font-weight: 600; }
.auth-tabs { margin: 24rpx 0; }
.form-tip, .session-note { margin: 24rpx 0; line-height: 1.7; }
.detail-heading { margin-top: 36rpx; }
.detail-row { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); overflow-wrap: anywhere; }
.badge { color: var(--accent); font-size: 22rpx; margin-left: 18rpx; }
.notice { padding: 24rpx; color: var(--accent); line-height: 1.65; }
.footer-links { display: flex; gap: 20rpx; }
.footer-links button { flex: 1; margin: 0; }
.account-section { padding-top: 32rpx; margin-top: 24rpx; border-top: 1rpx solid var(--line); }
.text-action { margin: 12rpx 0 0; padding: 0; background: transparent; color: var(--accent); text-align: left; font-size: 25rpx; line-height: 1.8; }
.text-action::after { border: 0; }
.scope-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.export-status { padding: 24rpx 0; line-height: 1.9; overflow-wrap: anywhere; }
.export-reader { margin-top: 28rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.export-body { height: 560rpx; margin-top: 20rpx; padding: 20rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 16rpx; font-family: monospace; font-size: 23rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.reader-actions { display: flex; gap: 20rpx; }
.reader-actions button { flex: 1; }
.danger-action { margin-top: 24rpx; border: 1rpx solid #a83745; background: transparent; color: #a83745; border-radius: 20rpx; font-size: 28rpx; }
.theme-dark .danger-action { border-color: #f3a2ad; color: #f3a2ad; }
.delete-panel { padding-top: 28rpx; margin-top: 28rpx; border-top: 1rpx solid var(--line); }

/* Account content rests on denser inset surfaces inside the shared glass. */
.account-page .title { margin:0 0 8px; font-size:30px; line-height:1.28; letter-spacing:-.6px; }
.account-page > .subtitle { margin-bottom:26px; }
.account-page .card { padding:22px; border-radius:28px; }
.account-page .section-title { margin:0 0 14px; line-height:1.5; }
.account-page .account-heading { gap:15px; align-items:center; }
.account-page .account-heading > view:last-child { min-width:0; flex:1; }
.account-page .account-heading .section-title { margin:0 0 4px; font-size:20px; }
.account-page .account-heading .muted { font-size:12px; }
.account-page .avatar { flex-shrink:0; width:54px; height:54px; border-radius:20px; font-size:25px; }
.account-page .detail-heading { margin:26px 0 12px; font-size:15px; }
.account-page .detail-row { padding:14px 16px; margin-top:10px; border-radius:18px; overflow-wrap:anywhere; }
.account-page .detail-row .row { align-items:flex-start; flex-wrap:wrap; gap:8px; }
.account-page .detail-row .label { font-size:14px; }
.account-page .detail-row .muted { margin-top:6px; font-size:13px; line-height:1.7; }
.account-page .badge { margin-left:0; padding:4px 9px; max-width:100%; border-radius:999px; background:var(--accent-soft); font-size:12px; line-height:18px; }
.account-page .form-tip, .account-page .session-note { margin:13px 0; font-size:13px; line-height:1.75; }
.account-page .account-section { padding-top:24px; margin-top:24px; }
.account-page .auth-tabs { gap:4px; margin:18px 0; padding:5px; border-radius:22px; }
.account-page .auth-tabs .chip { flex:1; min-width:0; min-height:44px; padding:10px 8px; font-size:13px; line-height:22px; border-radius:17px; }
.account-page .label { line-height:1.6; }
.account-page .field { height:52px; margin:12px 0; padding:14px 16px; border-radius:18px; font-size:15px; }
.glass-page.account-page .field.glass-field, .glass-page.account-page .export-body.glass-field { background:var(--glass-fill-strong); }
.account-page button.text-action { width:auto; min-height:44px; margin:7px 0 0; padding:10px 0; font-size:13px; line-height:24px; }
.account-page .scope-row { padding:14px 16px; gap:12px; border-radius:18px; }
.account-page .scope-row .label { min-width:0; font-size:14px; }
.account-page switch { flex-shrink:0; }
.account-page .export-status { padding:16px; margin-top:14px; border-radius:20px; font-size:13px; line-height:1.8; }
.account-page .export-status .row { align-items:flex-start; flex-wrap:wrap; gap:8px; margin-bottom:8px; }
.account-page .export-status .muted { margin-top:4px; font-size:13px; }
.account-page .export-reader { padding-top:20px; margin-top:22px; }
.account-page .export-reader > .row { align-items:flex-start; flex-wrap:wrap; }
.account-page .export-reader > .row .label { min-width:0; font-size:14px; }
.account-page .export-reader > .row .text-action { margin:0; }
.account-page .export-body { height:300px; padding:16px; margin-top:12px; border-radius:18px; font-size:12px; line-height:1.7; color:var(--text); }
.account-page .reader-actions { gap:10px; flex-wrap:wrap; }
.account-page .reader-actions button { min-width:100px; width:auto; font-size:14px; }
.glass-page.account-page button.danger-action:not([disabled]) { width:100%; min-height:48px; padding:12px 16px; margin-top:14px; border:1px solid rgba(163,61,57,.3); border-radius:22px; background:rgba(163,61,57,.07); color:#a23d39; font-size:14px; line-height:22px; }
.glass-page.account-page.theme-dark button.danger-action:not([disabled]) { border-color:rgba(245,166,156,.32); background:rgba(179,68,62,.13); color:#f2b0a8; }
.account-page .delete-panel { margin-top:18px; padding:18px; border-radius:22px; }
.account-page .delete-panel > .label { color:#a23d39; }
.account-page.theme-dark .delete-panel > .label { color:#f2b0a8; }
.account-page .notice { padding:16px 18px; margin:14px 0; border-radius:20px; font-size:14px; }
.account-page .footer-links { gap:10px; flex-wrap:wrap; margin-top:20px; padding:12px; }
.account-page .footer-links button { min-width:110px; font-size:14px; }

.glass-page.account-page button.danger-action { width:100%; min-height:48px; padding:12px 16px; margin-top:14px; border:1px solid var(--line); border-radius:22px; font-size:14px; line-height:22px; }
