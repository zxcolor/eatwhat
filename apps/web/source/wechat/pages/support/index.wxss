.feedback-input { box-sizing: border-box; width: 100%; min-height: 280rpx; padding: 24rpx; margin: 24rpx 0; border-radius: 20rpx; background: var(--soft); color: var(--text); }

/* A readable writing surface sits inside the feedback glass panel. */
.support-page .title { margin:0 0 9px; font-size:30px; line-height:1.3; letter-spacing:-.6px; }
.support-page > .subtitle { margin-bottom:26px; }
.support-page .card { padding:22px; border-radius:28px; }
.support-page .card > .chips { margin:0 0 18px; gap:8px; }
.support-page .chips .chip { font-size:13px; min-height:44px; line-height:22px; }
.glass-page.support-page .feedback-input.glass-field { width:100%; min-height:220px; margin:18px 0 12px; padding:17px; border:1px solid var(--line); border-radius:22px; background:var(--glass-fill-strong); color:var(--text); font-size:15px; line-height:1.8; }
.support-page .card > .muted { margin-top:12px; font-size:12px; line-height:1.75; overflow-wrap:anywhere; }
.support-page .primary { margin-top:22px; }
.support-page .section-title { margin:0 0 12px; font-size:18px; }
