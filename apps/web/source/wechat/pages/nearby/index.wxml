<view class="page glass-page utility-page nearby-page {{themeClass}} {{reducedMotion ? 'reduce-motion' : ''}}">
  <view class="glass-backdrop" aria-hidden="true"></view>
  <view class="page-eyebrow">本机保存 · 单独授权</view>
  <view class="title">附近餐厅缓存</view>
  <view class="subtitle">回看每次保存的附近餐厅。</view>
  <view class="card glass-panel collection-card">
    <view class="row"><view class="label">本机缓存</view><text class="state-badge {{enabled ? 'success-state' : ''}}">{{enabled ? '已开启' : '未开启'}}</text></view>
    <view class="muted spacing">每次打开单独保存，3.5 km 内最多两页。餐厅、本次位置与精度在 90 天到期时一并清理。</view>
    <view class="privacy-caption">仅前台获取位置；退出小程序后不后台定位。到期清理在下次打开或读取时执行。</view>
    <view wx:if="{{!consent}}" class="access-hint glass-inset">请先到“个人”阅读并同意隐私说明。</view>
    <view wx:elif="{{!available}}" class="access-hint glass-inset">当前服务未开放此功能。<button class="text-action" hover-class="utility-pressed" bindtap="openServiceSettings">到设置检查服务 ›</button></view>
    <button wx:if="{{!enabled}}" class="primary" hover-class="utility-pressed" disabled="{{!consent}}" bindtap="enableCollection">开启附近餐厅缓存</button>
    <button wx:else class="secondary" hover-class="utility-pressed" bindtap="disableCollection">关闭自动收集</button>
    <view wx:if="{{enabled}}" class="muted spacing">关闭后已有记录仍按保留期保存，可在下方清除。</view>
  </view>
  <view wx:if="{{enabled}}" class="card glass-panel collection-status" aria-live="polite">
    <view class="status-heading"><view class="status-dot {{busy ? 'is-busy' : phase === 'DONE' ? 'is-done' : ''}}"/><view class="label">{{statusLabel}}</view></view>
    <view wx:if="{{message}}" class="muted spacing">{{message}}</view>
    <button wx:if="{{canRetry}}" class="primary" hover-class="utility-pressed" bindtap="retry">{{phase === 'PERMISSION' ? '允许定位并收集' : '重新收集'}}</button>
    <button wx:if="{{phase === 'PERMISSION'}}" class="secondary" hover-class="utility-pressed" bindtap="openPermissionSettings">前往微信权限设置</button>
    <button wx:if="{{busy || phase === 'PERMISSION' || phase === 'FAILED'}}" class="text-action quiet-action" hover-class="utility-pressed" bindtap="dismiss">本次暂不收集</button>
  </view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view class="list-heading"><text>本机缓存</text><text>{{total}} 次</text></view>
  <block wx:if="{{busy && !snapshots.length}}"><view class="loading-label" aria-role="status">正在准备本次记录</view><view class="card glass-panel snapshot skeleton-card" aria-hidden="true"><view class="skeleton-line skeleton-title"/><view class="skeleton-line skeleton-meta"/><view class="skeleton-line skeleton-meta short"/><view class="skeleton-button"/></view></block>
  <view wx:elif="{{!snapshots.length && !error}}" class="card glass-panel empty-state"><view class="empty-symbol glass-inset">⌖</view><view class="empty-title">暂无本机餐厅缓存</view><view class="empty-copy">{{!consent ? '请先确认隐私选择。' : !enabled ? '开启并完成授权后，收集结果会保存在这里。' : '本次成功保存的餐厅会显示在这里。'}}</view></view>
  <view wx:for="{{snapshots}}" wx:key="id" class="card glass-panel snapshot">
    <view class="row snapshot-heading"><view class="label">{{item.time}}</view><text class="count-badge">{{item.count}} 家</text></view>
    <view class="muted spacing">{{item.status}} · {{item.pages}} 页</view>
    <view class="snapshot-meta glass-inset">{{item.accuracy}}<view>到期 {{item.expires}}</view></view>
    <button wx:if="{{item.count}}" class="secondary expand-button" hover-class="utility-pressed" data-id="{{item.id}}" bindtap="toggleSnapshot" aria-expanded="{{item.expanded}}"><text>{{item.expanded ? '收起餐厅' : '查看本次餐厅'}}</text><text class="expand-arrow {{item.expanded ? 'expanded' : ''}}">⌄</text></button>
    <view wx:if="{{item.expanded}}" class="places">
      <view wx:for="{{item.places}}" wx:for-item="place" wx:key="id" class="place glass-inset">
        <view class="place-heading"><view class="place-icon" aria-hidden="true">⌖</view><view class="place-copy"><view class="label">{{place.name}}</view><view class="place-address">{{place.address}}</view></view></view>
        <view class="place-facts"><text>{{place.cost}}</text><text>{{place.rating}}</text><text>{{place.open}}</text></view>
        <view class="source">{{place.source}} · {{place.mode}}</view>
      </view>
    </view>
  </view>
  <button wx:if="{{hasMore}}" class="secondary" hover-class="utility-pressed" bindtap="loadMore">查看更多记录</button>
  <button wx:if="{{consent}}" class="secondary danger-button" hover-class="utility-pressed" bindtap="clearCache">清除餐厅缓存与定位记录</button>
</view>
