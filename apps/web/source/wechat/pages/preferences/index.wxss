.preference-page {
  --preference-blue:#315dc3;
  --preference-surface:rgba(247,251,255,.32);
  --preference-rim:rgba(255,255,255,.86);
  --preference-edge:rgba(88,126,162,.23);
  --preference-selected:rgba(157,191,255,.3);
  --preference-selected-edge:rgba(65,106,207,.55);
  --preference-indicator:rgba(55,83,113,.4);
  min-height:100vh;
  padding:52px 20px calc(36px + env(safe-area-inset-bottom));
}
.preference-page.theme-dark {
  --preference-blue:#c0d3ff;
  --preference-surface:rgba(37,62,86,.5);
  --preference-rim:rgba(222,242,255,.39);
  --preference-edge:rgba(92,146,189,.3);
  --preference-selected:rgba(66,103,169,.42);
  --preference-selected-edge:rgba(164,199,255,.7);
  --preference-indicator:rgba(192,214,237,.48);
}
.preference-heading { width:100%; max-width:460px; margin:0 auto 30px; }
.preference-description { max-width:320px; color:var(--muted); font-size:14px; font-weight:500; line-height:1.75; }
.preference-title { margin:0 0 12px; color:var(--text); font-size:34px; font-weight:700; line-height:1.28; letter-spacing:-.8px; }
.preference-sliders { display:flex; flex-direction:column; gap:24px; width:100%; max-width:460px; margin:0 auto; }
.preference-sliders taste-slider { display:block; width:100%; }
.flavor-choice { padding-top:2px; }
.flavor-choice-title { margin:0 0 12px 2px; color:var(--muted); font-size:14px; font-weight:600; line-height:22px; }
.flavor-buttons { display:flex; gap:12px; }
button.flavor-button {
  position:relative;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex:1;
  width:0;
  min-height:70px;
  padding:20px 17px;
  border:1px solid var(--preference-rim);
  border-radius:22px;
  background:linear-gradient(145deg,rgba(255,255,255,.16),rgba(255,255,255,0) 58%),var(--preference-surface);
  color:var(--text);
  font-size:17px;
  line-height:26px;
  font-weight:600;
  box-shadow:0 8px 20px rgba(28,61,88,.07),inset 1px 1px 0 rgba(255,255,255,.3),inset -1px -1px 0 var(--preference-edge);
  -webkit-backdrop-filter:blur(20px) saturate(170%);
  backdrop-filter:blur(20px) saturate(170%);
  transition:background-color 140ms var(--ease-out),color 140ms var(--ease-out),transform 140ms var(--ease-out),box-shadow 140ms var(--ease-out);
}
.flavor-option-label { min-width:0; }
.flavor-selection-mark { position:relative; flex:0 0 18px; width:18px; height:18px; border:1.5px solid var(--preference-indicator); border-radius:50%; pointer-events:none; }
.flavor-selection-mark::after { content:""; position:absolute; top:3px; left:5px; width:4px; height:7px; border-right:1.5px solid transparent; border-bottom:1.5px solid transparent; transform:rotate(42deg); }
button.flavor-button.selected {
  border-color:var(--preference-selected-edge);
  background:linear-gradient(145deg,rgba(255,255,255,.23),rgba(255,255,255,0) 62%),var(--preference-selected);
  color:var(--preference-blue);
  box-shadow:0 8px 22px rgba(53,88,174,.13),inset 1px 1px 0 rgba(255,255,255,.72),inset -1px -1px 0 rgba(77,117,204,.18);
}
.flavor-button.selected .flavor-selection-mark { border-color:var(--preference-blue); background:var(--preference-blue); box-shadow:0 2px 7px rgba(49,93,195,.17); }
.flavor-button.selected .flavor-selection-mark::after { border-color:#fff; }
button.flavor-button-pressed { transform:scale(.98); }
button.flavor-button[disabled] { opacity:.55; }
.theme-dark button.flavor-button { box-shadow:0 8px 24px rgba(0,8,20,.19),inset 1px 1px 0 rgba(231,247,255,.13),inset -1px -1px 0 rgba(89,146,190,.22); }
.theme-dark button.flavor-button.selected { box-shadow:0 8px 24px rgba(0,8,20,.2),inset 1px 1px 0 rgba(228,242,255,.34),inset -1px -1px 0 rgba(93,143,227,.27); }
.theme-dark .flavor-button.selected .flavor-selection-mark::after { border-color:#24436e; }
.preference-error { max-width:460px; margin:20px auto 0; padding:13px 16px; border:1px solid var(--line); border-radius:18px; background:var(--accent-soft); color:var(--text); font-size:13px; line-height:1.7; }
button.enter-button {
  position:relative;
  display:block;
  width:100%;
  max-width:460px;
  min-height:56px;
  margin:30px auto 0;
  padding:15px 22px;
  border:1px solid rgba(255,255,255,.64);
  border-radius:28px;
  background:linear-gradient(145deg,rgba(135,101,244,.94),rgba(96,59,214,.96));
  color:#fff;
  font-size:16px;
  line-height:24px;
  font-weight:600;
  box-shadow:0 10px 24px rgba(79,48,164,.22),inset 1px 1px 0 rgba(255,255,255,.34),inset -1px -1px 0 rgba(57,29,133,.25);
  -webkit-backdrop-filter:blur(16px) saturate(170%);
  backdrop-filter:blur(16px) saturate(170%);
  transition:transform 140ms var(--ease-out),opacity 140ms var(--ease-out);
  animation:enter-appear 180ms var(--ease-out) both;
}
button.enter-button::before { content:""; position:absolute; inset:2px; border:1px solid rgba(255,255,255,.14); border-right-color:rgba(189,169,255,.38); border-bottom-color:rgba(174,144,255,.34); border-radius:inherit; pointer-events:none; }
button.enter-button-pressed { transform:scale(.98); opacity:.9; }
button.enter-button[disabled] { color:#fff; background:linear-gradient(145deg,rgba(135,101,244,.94),rgba(96,59,214,.96)); opacity:.55; }
.theme-dark button.enter-button { border-color:rgba(227,211,255,.6); background:linear-gradient(145deg,rgba(155,111,255,.94),rgba(110,67,221,.94)); color:#fff; box-shadow:0 10px 28px rgba(0,6,20,.28),inset 1px 1px 0 rgba(246,234,255,.32),inset -1px -1px 0 rgba(81,40,166,.4); }
@keyframes enter-appear { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
.reduce-motion button.enter-button { animation:none; transition:none; }.reduce-motion button.enter-button:active,.reduce-motion button.enter-button-pressed { transform:none; }
.reduce-motion button.flavor-button { transition:none; }.reduce-motion button.flavor-button-pressed { transform:none; }
@media (prefers-reduced-motion:reduce) { button.enter-button { animation:none; transition:none; }button.enter-button:active,button.enter-button-pressed { transform:none; }button.flavor-button { transition:none; }button.flavor-button-pressed { transform:none; } }
@media (prefers-reduced-transparency:reduce), (prefers-contrast:more) {
  .preference-page { --preference-surface:#f5f9fc; --preference-rim:#aebfcc; --preference-selected:#e2ebff; }
  .preference-page.theme-dark { --preference-surface:#21384d; --preference-rim:#728ba2; --preference-selected:#304e7d; }
  button.flavor-button,button.enter-button { -webkit-backdrop-filter:none; backdrop-filter:none; }
}
@media (max-width:350px) { .preference-page { padding-left:16px; padding-right:16px; }.preference-title { font-size:30px; }.preference-heading { margin-bottom:26px; }.preference-sliders { gap:20px; }button.flavor-button { padding-left:14px; padding-right:14px; } }
