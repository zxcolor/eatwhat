.route-page { padding:24px 18px calc(32px + env(safe-area-inset-bottom)); }
.route-heading { margin:0 4px 20px; }
.eyebrow { margin-bottom:9px; color:var(--accent); font-size:12px; font-weight:600; letter-spacing:1.2px; }
.destination-title { color:var(--text); font-size:27px; font-weight:650; line-height:1.4; overflow-wrap:anywhere; }
.origin-caption { margin-top:10px; color:var(--muted); font-size:13px; line-height:1.7; overflow-wrap:anywhere; }
.mode-tabs { display:flex; gap:6px; padding:5px; margin-bottom:16px; border-radius:20px; }
.mode-tab { flex:1; min-width:0; min-height:44px; margin:0; padding:10px; color:var(--muted); background:transparent; border-radius:15px; font-size:14px; line-height:24px; }
.mode-tab.selected { background:var(--card); color:var(--accent); font-weight:650; box-shadow:0 2px 8px rgba(23,43,60,.08); }
.map-frame { overflow:hidden; border-radius:24px; padding:0; }
.route-map { display:block; width:100%; height:360px; }
.route-summary { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:14px 0 24px; padding:19px; border-radius:23px; }
.route-duration { margin-bottom:4px; font-size:28px; font-weight:650; line-height:1.3; font-variant-numeric:tabular-nums; }
.overview-button { flex:0 0 auto; min-height:44px; margin:0; padding:10px 13px; border-radius:14px; color:var(--accent); font-size:13px; line-height:24px; }
.subtle { color:var(--muted); font-size:12px; line-height:1.8; overflow-wrap:anywhere; }
.steps-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:7px; margin:0 4px 12px; font-size:16px; font-weight:600; }
.steps-heading text { color:var(--muted); font-size:11px; font-weight:400; }
.steps-list { padding:0 16px; border-radius:24px; overflow:hidden; }
.route-step { display:flex; align-items:flex-start; gap:12px; width:100%; margin:0; padding:18px 0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; color:var(--text); text-align:left; white-space:normal; }
.route-step:last-child { border-bottom:0; }
.step-number { display:flex; align-items:center; justify-content:center; flex:0 0 26px; height:26px; margin-top:2px; background:var(--soft); color:var(--muted); border-radius:9px; font-size:12px; font-weight:600; }
.step-selected .step-number { color:var(--accent); background:var(--accent-soft); }
.step-selected .step-instruction { color:var(--accent); }
.step-copy { flex:1; min-width:0; }
.step-instruction { margin-bottom:5px; font-size:14px; line-height:1.7; overflow-wrap:anywhere; }
.step-chevron { margin-top:3px; color:var(--muted); font-size:22px; line-height:24px; }
.route-footnote { margin:16px 4px 22px; color:var(--muted); font-size:11px; line-height:1.9; }
.route-message,.route-empty { margin:20px 0; padding:26px 22px; border-radius:24px; font-size:14px; line-height:1.85; }
.loading-label { margin-bottom:8px; font-size:16px; font-weight:600; }
.route-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
.route-actions .secondary { flex:1; min-width:120px; min-height:50px; margin:0; padding:12px 8px; }
.route-empty { text-align:center; }
.empty-title { margin-bottom:12px; font-size:22px; font-weight:650; }
.route-empty .primary { margin-top:22px; }
.reduced-motion button { transition:none; }
@media (max-width:350px) { .route-page { padding-left:12px; padding-right:12px; } .route-map { height:300px; } .route-duration { font-size:25px; } }
