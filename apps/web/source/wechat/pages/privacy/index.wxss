.privacy-copy { margin-top: 22rpx; line-height: 1.85; color: inherit; font-size: 28rpx; overflow-wrap: anywhere; }

/* Long-form reading uses a denser glass fill without changing the policy content. */
.privacy-page .title { margin:0 0 9px; font-size:30px; line-height:1.3; letter-spacing:-.6px; }
.privacy-page > .subtitle { margin-bottom:26px; font-size:14px; line-height:1.7; }
.glass-page.privacy-page .glass-panel.privacy-section { padding:22px; margin-bottom:18px; border-radius:28px; background:var(--glass-fill-strong); }
.privacy-page .section-title { margin:0 0 16px; padding-left:13px; border-left:3px solid var(--accent); color:var(--text); font-size:17px; line-height:1.55; font-weight:650; }
.privacy-page .privacy-copy { margin-top:15px; color:var(--text); font-size:14px; line-height:1.9; letter-spacing:.01em; overflow-wrap:anywhere; }
.privacy-page .secondary { min-height:48px; padding:12px 16px; margin-top:20px; font-size:14px; line-height:24px; }
