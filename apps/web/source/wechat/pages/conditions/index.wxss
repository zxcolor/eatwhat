.conditions-page { padding:28px 20px calc(170px + env(safe-area-inset-bottom)); }
.conditions-page > .title { margin:2px 4px 11px; font-size:30px; line-height:1.35; letter-spacing:-.6px; }
.conditions-page > .subtitle { margin:0 4px 25px; font-size:13px; line-height:1.85; }
.conditions-page .card { margin-bottom:17px; border-radius:28px; }
.service-card { padding:22px; }
button.origin-card { display:flex; align-items:center; gap:13px; width:100%; padding:19px 18px; color:var(--text); line-height:1.5; text-align:left; white-space:normal; }
.origin-symbol { display:flex; align-items:center; justify-content:center; flex:0 0 43px; width:43px; height:43px; border:1px solid var(--line); border-radius:15px; background:var(--soft); color:var(--accent); font-size:23px; }
.origin-content { flex:1; min-width:0; }
.origin-caption { margin-bottom:5px; color:var(--muted); font-size:12px; font-weight:600; line-height:1.6; letter-spacing:.3px; }
.origin-content .label { font-size:15px; line-height:1.6; overflow-wrap:anywhere; }
.origin-change { flex-shrink:0; color:var(--accent); font-size:12px; font-weight:600; line-height:1.8; white-space:nowrap; }
.limits-card { padding:23px 21px 4px; }
.form-field { padding-bottom:23px; }
.form-field + .form-field { padding-top:23px; border-top:1px solid var(--line); }
.form-field .section-title { margin:0 0 10px; font-size:16px; font-weight:650; line-height:1.5; }
.form-field .chips { gap:8px; margin:15px 0 0; }
.form-field .chip { max-width:100%; min-height:44px; padding:11px 14px; font-size:12px; line-height:22px; white-space:normal; overflow-wrap:anywhere; }
.field-caption { color:var(--muted); font-size:12px; line-height:1.85; }
.page.glass-page .conditions-footer { position:fixed; left:14px; right:14px; bottom:calc(12px + env(safe-area-inset-bottom)); z-index:20; max-width:680px; margin:0 auto; padding:13px 14px 14px; border-radius:29px; }
.footer-note { margin-bottom:10px; color:var(--muted); font-size:12px; font-weight:500; line-height:1.7; text-align:center; }
.conditions-footer .primary { min-height:54px; margin-top:0; }
.conditions-footer .error { margin:0 0 12px; padding:11px 13px; font-size:12px; line-height:1.75; }
@media (max-width:350px) {
  .conditions-page { padding-left:16px; padding-right:16px; }
  .conditions-page > .title { font-size:27px; }
  button.origin-card { gap:10px; padding:18px 15px; }
  .origin-symbol { flex-basis:38px; width:38px; height:38px; border-radius:13px; }
  .origin-content .label { font-size:14px; }
  .origin-change { font-size:12px; }
  .limits-card { padding:22px 18px 3px; }
  .form-field .chip { padding:10px 12px; }
  .page.glass-page .conditions-footer { left:12px; right:12px; }
}
