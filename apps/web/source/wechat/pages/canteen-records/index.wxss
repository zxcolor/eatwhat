.history-eyebrow { font-size:12px; color:var(--muted); margin-bottom:10px; }.canteen-history > .subtitle { margin-bottom:22px; }.remember-copy { font-size:12px; margin-top:10px; }.remember-card switch { flex-shrink:0; }
.empty-records { text-align:center; padding:28px 22px; }.empty-records .muted { margin-top:10px; font-size:13px; }.empty-symbol { width:52px; height:52px; border-radius:18px; background:var(--soft); color:var(--accent); font-size:23px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
.record-time { color:var(--muted); font-size:12px; margin-bottom:10px; }.record-name { font-size:19px; line-height:1.5; font-weight:600; overflow-wrap:anywhere; word-break:break-all; }.record-stall { font-size:14px; color:var(--accent); margin-top:7px; }.record-price { font-size:15px; line-height:25px; margin-top:13px; }.weight-note { font-size:12px; margin-top:5px; }
.reduce-motion button { transition:none; }.reduce-motion button:active { transform:none; }

/* Historical menu facts stay distinct from the date and the retention control. */
.canteen-history .title { margin:0 0 9px; font-size:30px; line-height:1.3; letter-spacing:-.6px; }
.canteen-history .history-eyebrow { font-size:12px; line-height:20px; letter-spacing:.06em; }
.canteen-history > .subtitle { margin-bottom:26px; }
.canteen-history .card { padding:22px; border-radius:28px; }
.canteen-history .remember-card .row { align-items:flex-start; gap:14px; }
.canteen-history .remember-card .label { min-width:0; flex:1; font-size:16px; line-height:25px; }
.canteen-history .remember-copy { margin-top:13px; font-size:13px; line-height:1.75; }
.canteen-history .empty-records { padding:30px 22px; }
.canteen-history .empty-symbol { width:60px; height:60px; border-radius:22px; font-size:27px; }
.canteen-history .empty-records .muted { font-size:13px; line-height:1.8; }
.canteen-history .record-time { margin-bottom:14px; font-size:12px; line-height:20px; }
.canteen-history .record-name { font-size:21px; line-height:1.5; letter-spacing:-.3px; word-break:normal; overflow-wrap:anywhere; }
.canteen-history .record-stall { font-size:14px; line-height:23px; margin-top:7px; }
.canteen-history .record-price { display:inline-block; max-width:100%; padding:10px 14px; margin-top:18px; border-radius:16px; font-size:16px; line-height:26px; font-weight:600; overflow-wrap:anywhere; }
.canteen-history .weight-note { padding-top:13px; margin-top:15px; border-top:1px solid var(--line); font-size:12px; line-height:21px; }
.glass-page.canteen-history button.danger-button { color:#a23d39; background:rgba(163,61,57,.055); border-color:rgba(163,61,57,.22); }
.glass-page.canteen-history.theme-dark button.danger-button { color:#f2b0a8; background:rgba(179,68,62,.11); border-color:rgba(242,176,168,.26); }
