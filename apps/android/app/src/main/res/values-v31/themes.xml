        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/launcher_page</item>
        <item name="android:statusBarColor">@color/launcher_page</item>
        <item name="android:navigationBarColor">@color/launcher_page</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_page</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_raspberry</item>
    </style>
