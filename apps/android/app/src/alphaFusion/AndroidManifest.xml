<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Merged only into an explicitly requested, integrity-pinned Fusion Alpha.
        Runtime access is requested after durable consent and a direct user tap.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <activity
            android:name=".auth.fusion.FusionProtocolActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.ChiShenMe">
            <intent-filter>
                <action android:name="com.fusion.auth" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
