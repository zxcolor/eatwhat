.page { min-height: 100vh; box-sizing: border-box; padding: 34rpx; background: var(--bg); color: var(--text); }
.hero { padding: 24rpx 8rpx; }
.title, .subtitle, .label, .count, .status { display: block; }
.title { font-size: 45rpx; font-weight: 800; }
.subtitle { margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.55; }
.card { margin-top: 16rpx; padding: 30rpx; border-radius: 28rpx; background: var(--surface); }
.label { font-size: 26rpx; font-weight: 700; }
.label.top { margin-top: 30rpx; }
.picker, textarea { margin-top: 12rpx; box-sizing: border-box; border: 2rpx solid var(--border); border-radius: 18rpx; background: var(--surface); }
.picker { padding: 22rpx; }
textarea { width: 100%; min-height: 300rpx; padding: 22rpx; font-size: 26rpx; }
.count { margin-top: 8rpx; text-align: right; color: var(--muted); font-size: 24rpx; }
.status { margin-top: 18rpx; color: var(--primary); font-size: 25rpx; line-height: 1.5; }
button { margin-top: 26rpx; background: var(--primary); color: var(--on-primary); border-radius: 20rpx; }
