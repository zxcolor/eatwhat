.page { min-height: 100vh; box-sizing: border-box; padding: 52rpx 34rpx 44rpx; background: var(--bg); color: var(--text); }
.hero { display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx 8rpx 30rpx; }
.title { font-size: 56rpx; line-height: 1.15; font-weight: 800; }
.subtitle, .version { color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.card { padding: 12rpx 30rpx; background: var(--surface); border-radius: 30rpx;  }
.feature { display: flex; gap: 20rpx; padding: 25rpx 0; border-bottom: 1rpx solid var(--border); }
.feature:last-child { border-bottom: 0; }
.dot { width: 54rpx; height: 54rpx; line-height: 54rpx; text-align: center; border-radius: 50%; background: var(--surface-soft); color: var(--primary); font-size: 24rpx; font-weight: 800; flex: none; }
.feature-title, .feature-body { display: block; }
.feature-title { font-weight: 750; font-size: 29rpx; margin-bottom: 8rpx; }
.feature-body { color: var(--muted); font-size: 25rpx; line-height: 1.55; }
.links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; margin: 24rpx 0 16rpx; }
.links button { margin: 0; background: var(--bg); color: var(--primary); font-size: 25rpx; border-radius: 18rpx; }
.version { display: block; font-size: 24rpx; }
.primary, .secondary { margin-top: 22rpx; border-radius: 22rpx; height: 92rpx; line-height: 92rpx; font-size: 29rpx; font-weight: 700; }
.primary { background: var(--primary); color: var(--on-primary); }
.secondary { margin-top: 12rpx; background: transparent; color: var(--muted); border: 2rpx solid var(--border); }
.error { display: block; margin-top: 18rpx; color: var(--danger); font-size: 24rpx; }
.overlay { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(9, 18, 13, .48); }
.sheet { width: 100%; box-sizing: border-box; max-height: 78vh; overflow: auto; padding: 38rpx 34rpx 48rpx; border-radius: 34rpx 34rpx 0 0; background: var(--surface); }
.sheet-title, .sheet-body { display: block; }
.sheet-title { font-size: 34rpx; font-weight: 800; margin-bottom: 18rpx; }
.sheet-body { color: var(--primary); font-size: 27rpx; line-height: 1.75; }
.close { margin-top: 30rpx; background: var(--bg); color: var(--primary); border-radius: 18rpx; }
