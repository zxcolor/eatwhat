.page { min-height: 100vh; box-sizing: border-box; padding: 160rpx 54rpx; text-align: center; background: var(--bg); color: var(--text); }
.icon { width: 110rpx; height: 110rpx; margin: 0 auto 34rpx; border-radius: 50%; line-height: 110rpx; background: var(--surface-soft); color: var(--primary); font-size: 54rpx; font-weight: 800; }
.title, .body { display: block; }
.title { font-size: 44rpx; font-weight: 800; }
.body { margin-top: 22rpx; color: var(--muted); font-size: 27rpx; line-height: 1.7; }
button { margin-top: 44rpx; border-radius: 22rpx; background: var(--primary); color: var(--on-primary); }
.local-action { margin-top: 18rpx; background: var(--surface-soft); color: var(--text); }
