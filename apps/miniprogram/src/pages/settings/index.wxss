.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 32rpx 54rpx; background: var(--bg); color: var(--text); }
.group-title { display: block; margin: 30rpx 8rpx 14rpx; color: var(--primary); font-size: 27rpx; font-weight: 800; }
.card { margin-bottom: 16rpx; padding: 26rpx; border-radius: 24rpx; background: var(--surface); }
.row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.row > view:first-child { flex: 1; }
.title, .description, .empty, .history-title, .about text { display: block; }
.title { font-size: 29rpx; font-weight: 750; }
.description, .empty { margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.card button { width: auto; min-width: 112rpx; margin: 0; padding: 0 18rpx; background: var(--bg); color: var(--primary); font-size: 24rpx; border-radius: 16rpx; }
.history-item { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding-top: 20rpx; margin-top: 20rpx; border-top: 1rpx solid var(--border); }
.history-title { font-size: 25rpx; font-weight: 700; }
.count { color: var(--primary); font-size: 24rpx; white-space: nowrap; }
.picker { padding: 14rpx 18rpx; background: var(--bg); color: var(--primary); border-radius: 16rpx; font-size: 24rpx; }
.about { display: flex; flex-direction: column; gap: 8rpx; margin: 24rpx 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.withdraw { margin-top: 28rpx; border: 2rpx solid var(--border); background: transparent; color: var(--danger); border-radius: 20rpx; }
.overlay { position: fixed; inset: 0; z-index: 10; display: flex; align-items: flex-end; background: rgba(9, 18, 13, .48); }
.sheet { width: 100%; box-sizing: border-box; padding: 38rpx 34rpx 52rpx; border-radius: 32rpx 32rpx 0 0; background: var(--surface); color: var(--primary); font-size: 27rpx; line-height: 1.7; }
.sheet button { margin-top: 28rpx; background: var(--bg); color: var(--primary); border-radius: 18rpx; }
