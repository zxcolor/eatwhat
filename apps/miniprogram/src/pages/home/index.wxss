.page { padding-bottom: calc(244rpx + env(safe-area-inset-bottom)); }
.brand-row { display: flex; justify-content: space-between; align-items: center; padding: 8rpx 2rpx 30rpx; }
.brand-row .title { font-size: 46rpx; }
.brand-row .subtitle { margin-top: 6rpx; }
.settings-button { width: auto; margin: 0; color: var(--primary); background: var(--primary-soft); }
.decision-banner { padding: 38rpx; border-radius: 30rpx; background: #224780; color: #fff; }
.banner-title { display: block; white-space: pre-line; font-size: 52rpx; font-weight: 750; line-height: 1.35; }
.banner-body { display: block; margin-top: 20rpx; font-size: 27rpx; color: #e2eaff; }
.location-label { display: block; font-size: 33rpx; font-weight: 700; line-height: 1.4; }
.mini-title { display: block; margin: 24rpx 0 14rpx; font-size: 27rpx; font-weight: 600; }
.location-card .mini-title { margin-top: 0; color: var(--muted); }
.location-note { display: block; padding: 16rpx 18rpx; margin: 20rpx 0; border-radius: 18rpx; background: var(--surface-soft); color: var(--muted); font-size: 25rpx; }
.location-actions, .segmented { display: flex; gap: 16rpx; }
.location-actions button, .mode-option { flex: 1; margin: 0; }
.outlined { background: var(--surface); color: var(--primary); border: 1rpx solid var(--border); }
.segmented { margin-top: 22rpx; }
.mode-option { padding: 26rpx 20rpx; text-align: left; border: 2rpx solid var(--border); background: var(--bg); color: var(--text); }
.mode-option.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
.mode-note { display: block; font-size: 24rpx; font-weight: 400; color: var(--muted); margin-top: 6rpx; }
.scenario-section { padding: 18rpx 6rpx 0; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.scenario-section .chips { margin-top: 20rpx; }
.chip { width: auto; margin: 0; padding: 20rpx 22rpx; min-height: 88rpx; border-radius: 20rpx; background: var(--surface-soft); font-size: 26rpx; }
.chip.active { background: var(--primary-soft); color: var(--primary); box-shadow: inset 0 0 0 2rpx var(--primary); }
.danger .chip.active { color: var(--danger); background: var(--danger-soft); box-shadow: inset 0 0 0 2rpx var(--danger); }
.field { display: flex; flex-direction: column; gap: 12rpx; margin-top: 24rpx; color: var(--muted); font-size: 26rpx; }
.quick-summary { display: block; margin-top: 24rpx; color: var(--muted); font-size: 26rpx; }
.search-row { display: flex; gap: 12rpx; }
.search-input { min-width: 0; flex: 1; }
.search-button { width: auto; margin: 0; background: var(--primary-soft); color: var(--primary); }
.option-stack { display: flex; flex-direction: column; gap: 12rpx; margin-top: 16rpx; }
.location-result { text-align: left; margin: 0; padding: 20rpx; }
.result-name, .result-meta { display: block; }
.result-meta { color: var(--muted); font-size: 24rpx; font-weight: 400; margin-top: 8rpx; }
.checkbox-row { display: flex; align-items: center; margin-top: 28rpx; font-size: 26rpx; }
.page-error { display: block; padding: 12rpx 6rpx; }
.remote-blocked { padding: 12rpx 4rpx; }
.remote-blocked button { margin-top: 16rpx; }
.decision-footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 22rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); z-index: 5; }
.recommend { margin: 0; min-height: 98rpx; font-size: 32rpx; }
.footer-note { display: block; margin-top: 12rpx; text-align: center; color: var(--muted); font-size: 24rpx; }

/* Keep text and touch targets legible when rpx scales down on narrow phones. */
.page { font-size: 14px; }
.page button { min-height: 44px; font-size: 14px; }
.page .recommend { font-size: 16px; }
.banner-body, .field, .checkbox-row, .mini-title, .search-input { font-size: 14px; }
.page .subtitle, .page .description, .page .hint, .location-note,
.mode-note, .quick-summary, .result-meta, .footer-note { font-size: 12px; }
