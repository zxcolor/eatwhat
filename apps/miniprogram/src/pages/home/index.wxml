<view class="page {{themeClass}}">
  <view class="brand-row"><view><text class="title">吃什么</text><text class="subtitle">附近美食，少一点纠结</text></view><button class="settings-button" bindtap="onSettings">设置</button></view>
  <view class="decision-banner"><text class="banner-title">这一顿，
交给我们来选</text><text class="banner-body">从位置和条件出发，收窄附近选择。</text></view>

  <view class="card location-card">
    <view class="row"><view><text class="mini-title">从哪里出发</text><text class="location-label">{{locationLabel}}</text></view><text class="badge">{{locationSelected ? '已选择' : '待选择'}}</text></view>
    <text class="location-note">定位只会在你主动点击后开始；位置只用于本次推荐。</text>
    <view class="location-actions"><button class="secondary" loading="{{locationMessage === '正在获取本次定位…'}}" bindtap="onLocate">自动定位</button><button class="outlined" bindtap="onToggleLocationChooser">{{locationChooserOpen ? '收起选择' : '手动选择'}}</button></view>
    <text wx:if="{{locationMessage}}" class="hint">{{locationMessage}}</text>
    <view wx:if="{{locationChooserOpen}}" class="location-chooser">
      <text class="mini-title">搜索学校、商圈或地址</text>
      <view class="search-row"><input class="input search-input" value="{{locationQuery}}" maxlength="80" placeholder="输入推荐起点" confirm-type="search" bindinput="onLocationQueryInput" bindconfirm="onSearchLocation" /><button class="search-button" loading="{{locationSearching}}" disabled="{{!locationSearchEnabled || locationSearching}}" bindtap="onSearchLocation">搜索</button></view>
      <text wx:if="{{!locationSearchEnabled}}" class="hint">地点搜索暂不可用，仍可使用快捷地点。</text>
      <text wx:if="{{searchMessage}}" class="hint">{{searchMessage}}</text>
      <view class="option-stack"><button wx:for="{{searchResults}}" wx:key="index" class="location-result" data-index="{{item.index}}" bindtap="onSelectSearchLocation"><text class="result-name">{{item.name}}</text><text class="result-meta">{{item.address}} · {{item.sourceLabel}}</text></button></view>
      <text class="mini-title">快捷地点</text>
      <view class="chips"><button wx:for="{{builtInLocations}}" wx:key="index" class="chip {{item.active ? 'active' : ''}}" data-index="{{item.index}}" bindtap="onSelectBuiltInLocation">{{item.label}}</button></view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">怎么决定</text><text class="hint">极速模式一键给答案，精细模式可调整全部条件</text>
    <view class="segmented"><button wx:for="{{decisionModes}}" wx:key="value" class="mode-option {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onDecisionMode"><text>{{item.label}}</text><text class="mode-note">{{item.value === 'QUICK' ? '少操作' : '更可控'}}</text></button></view>
  </view>

  <view class="scenario-section"><text class="section-title">主动场景</text><text class="hint">一键套用常用条件；地点和已选菜系保持不变</text><view class="chips"><button wx:for="{{scenarios}}" wx:key="value" class="chip scenario {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onScenario">{{item.label}}</button></view></view>

  <view class="card conditions">
    <text class="section-title">本次条件</text>
    <view wx:if="{{targets.length > 1}}"><text class="mini-title">想找什么</text><view class="chips"><button wx:for="{{targets}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onTarget">{{item.label}}</button></view></view>
    <text class="mini-title">餐段</text><view class="chips"><button wx:for="{{mealPeriods}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onMealPeriod">{{item.label}}</button></view>
    <text wx:if="{{!isGuided}}" class="quick-summary">{{quickSummary}}</text>
    <view wx:if="{{isGuided}}" class="guided">
      <label class="field"><text>预算上限 · 元（留空为不限）</text><input class="input" type="number" maxlength="4" value="{{budget}}" bindinput="onBudgetInput" /></label>
      <label class="field"><text>可用时间 · 分钟（15–240）</text><input class="input" type="number" maxlength="3" value="{{availableMinutes}}" bindinput="onMinutesInput" /></label>
      <label class="field"><text>最远距离 · 米（200–{{maximumRadiusMeters}}）</text><input class="input" type="number" maxlength="5" value="{{radiusMeters}}" bindinput="onRadiusInput" /></label>
      <text class="mini-title">出行方式</text><view class="chips"><button wx:for="{{travelModes}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onTravelMode">{{item.label}}</button></view>
      <block wx:if="{{softPreferencesAvailable}}"><text class="mini-title">探索程度</text><view class="chips"><button wx:for="{{explorationModes}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onExplorationMode">{{item.label}}</button></view><text class="mini-title">偏好菜系</text><view class="chips"><button wx:for="{{cuisines}}" wx:key="name" class="chip {{item.preferred ? 'active' : ''}}" data-kind="preferred" data-cuisine="{{item.name}}" bindtap="onCuisine">{{item.name}}</button></view></block>
      <text class="mini-title">排除菜系</text><view class="chips danger"><button wx:for="{{cuisines}}" wx:key="name" class="chip {{item.excluded ? 'active' : ''}}" data-kind="excluded" data-cuisine="{{item.name}}" bindtap="onCuisine">{{item.name}}</button></view>
      <text class="hint">仅根据已有菜系标签排除，过敏和饮食禁忌仍需向商户确认。</text>
      <view wx:if="{{weatherEnabled}}"><text class="mini-title">这次想吃的感觉</text><view class="chips"><button wx:for="{{weatherOptions}}" wx:key="value" class="chip {{item.active ? 'active' : ''}}" data-value="{{item.value}}" bindtap="onWeather">{{item.label}}</button></view><text class="hint">由你主动选择，仅本次生效。</text></view>
      <checkbox-group wx:if="{{aiAvailable}}" bindchange="onAiPreference"><label class="checkbox-row"><checkbox value="AI" color="#315bd5" checked="{{aiAssistancePreferred}}" />允许 AI 辅助理解本次偏好</label></checkbox-group>
    </view>
  </view>
  <text wx:if="{{formError}}" class="error page-error">{{formError}}</text>
  <view wx:if="{{!remoteReady}}" class="remote-blocked"><text class="hint">正在确认推荐服务，确认前无法提交。</text><button bindtap="onRetryConfig">重新连接</button></view>
  <view class="decision-footer"><button class="recommend" loading="{{recommendationLoading}}" disabled="{{recommendationLoading || !remoteReady}}" bindtap="onRecommend">{{recommendationLoading ? '正在帮你筛选' : '帮我决定'}}</button><text class="footer-note">最多 3 个候选 · 每个选择都有可核对理由</text></view>
</view>
