.page-shell { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx calc(44rpx + env(safe-area-inset-bottom)); }
.header-row,.row,.session-row,.switch-row,.button-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.eyebrow,.headline,.section-title,.field-label,.hint,.privacy-note { display: block; }
.headline { margin-top: 8rpx; font-size: 44rpx; font-weight: 750; }
.small-button { margin: 0; padding: 0 26rpx; border-radius: 999rpx; background: var(--primary); color: var(--on-primary); font-size: 24rpx; }
.status-card,.section-card { margin-top: 24rpx; padding: 28rpx; border-radius: 26rpx; background: var(--surface); border: 1rpx solid var(--border); }
.status-card { color: var(--muted); font-size: 25rpx; }
.status-card--success { border-color: var(--border); background: var(--bg); }
.status-card--warning { border-color: var(--border); background: var(--surface-soft); }
.status-card--error { border-color: var(--border); background: var(--bg); }
.section-title { font-size: 30rpx; font-weight: 700; }
.row,.session-row { min-height: 82rpx; border-bottom: 1rpx solid var(--border); }
.row:last-child,.session-row:last-child { border-bottom: 0; }
.row-title { font-size: 27rpx; font-weight: 600; }
.badge { margin-left: 12rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--warning-soft); color: var(--danger); font-size: 24rpx; }
.success-text { color: var(--primary); font-size: 24rpx; }
.bind-form { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--border); }
.field-label { color: var(--muted); font-size: 24rpx; }
.field-input { box-sizing: border-box; height: 82rpx; margin-top: 12rpx; padding: 0 20rpx; border-radius: 18rpx; background: var(--surface); border: 1rpx solid var(--border); font-size: 27rpx; }
.hint { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.primary-button,.secondary-button,.delete-button,.logout-button { border-radius: 20rpx; font-size: 27rpx; }
.primary-button { margin-top: 18rpx; background: var(--primary); color: var(--on-primary); }
.secondary-button { margin-top: 16rpx; background: var(--primary); color: var(--on-primary); }
.compact { flex: 1; margin-top: 18rpx; }
.session-copy { flex: 1; min-width: 0; }
.danger-link { margin: 0; padding: 0 12rpx; background: transparent; color: var(--danger); font-size: 24rpx; }
.switch-row { margin-top: 20rpx; font-size: 25rpx; }
.danger-card { border-color: var(--border); }
.danger-text { color: var(--danger); }
.delete-button { margin-top: 18rpx; background: var(--warning-soft); color: var(--on-primary); }
.delete-button[disabled] { background: var(--warning-soft); color: var(--on-primary); }
.logout-button { margin-top: 28rpx; background: transparent; color: var(--danger); border: 1rpx solid var(--border); }
.privacy-note { margin-top: 20rpx; color: var(--muted); text-align: center; font-size: 24rpx; line-height: 1.5; }
