<view class="page {{themeClass}}">
  <view class="title">设置</view>
  <view class="subtitle">让吃什么，保持你喜欢的样子。</view>
  <view class="card">
    <view class="section-title">外观</view>
    <view class="chips theme-options">
      <button class="chip {{theme === 'system' ? 'selected' : ''}}" data-theme="system" bindtap="changeTheme">跟随系统</button>
      <button class="chip {{theme === 'light' ? 'selected' : ''}}" data-theme="light" bindtap="changeTheme">浅色</button>
      <button class="chip {{theme === 'dark' ? 'selected' : ''}}" data-theme="dark" bindtap="changeTheme">深色</button>
    </view>
  </view>
  <view class="card">
    <view class="section-title">服务状态</view>
    <view class="muted setting-description">{{statusLabel}}</view>
    <button class="secondary" loading="{{busy}}" disabled="{{busy || !consent}}" bindtap="refreshService">重新检查服务</button>
    <view wx:if="{{!consent}}" class="muted">请先在首页阅读并同意隐私说明。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>
  <view class="card">
    <view class="section-title">隐私</view>
    <button class="secondary" bindtap="openPrivacy">查看隐私说明</button>
    <button wx:if="{{consent}}" class="secondary" bindtap="withdrawConsent">撤回隐私同意</button>
    <view class="muted">定位由你主动发起。撤回同意将清除本次位置、推荐结果和登录状态。</view>
  </view>
  <view class="card"><view class="row"><text class="label">吃什么 · 微信小程序</text><text class="muted">{{version}}</text></view><view class="muted setting-description">从零构建中的开发版本。</view></view>
</view>
