<view class="page {{themeClass}}">
  <view class="title">我的账号</view>
  <view class="subtitle">一个人的用餐决定，也值得被认真对待。</view>
  <view wx:if="{{signedIn}}" class="card">
    <view class="account-heading"><view class="avatar">食</view><view><view class="section-title">已登录</view><view class="muted">本次小程序运行期间有效</view></view></view>
    <view class="muted session-note">登录状态只保存在内存；离开小程序或登录过期后，需要重新登录。</view>
    <view class="section-title detail-heading">账号身份</view>
    <view wx:for="{{identities}}" wx:key="id" class="detail-row">
      <view class="row"><text class="label">{{item.label}}</text><text wx:if="{{item.primary}}" class="badge">主账号</text></view>
      <view class="muted">{{item.maskedValue}}</view>
    </view>
    <view wx:if="{{!identities.length}}" class="muted">点击下方按钮读取账号身份。</view>
    <view class="section-title detail-heading">登录设备</view>
    <view wx:for="{{sessions}}" wx:key="id" class="detail-row">
      <view class="row"><text class="label">{{item.label}}</text><text wx:if="{{item.current}}" class="badge">当前设备</text></view>
      <view class="muted">{{item.platform}} · {{item.lastActive}}</view>
    </view>
    <view wx:if="{{!sessions.length}}" class="muted">点击下方按钮读取登录设备。</view>
    <button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="refreshDetails">刷新账号信息</button>
    <button class="secondary" disabled="{{busy}}" bindtap="logout">退出登录</button>
    <view class="muted session-note">邮箱绑定、设备撤销、数据导出与账号注销尚未在小程序接入。</view>
  </view>
  <view wx:elif="{{capabilities.accountsEnabled}}" class="card">
    <view class="section-title">{{purpose === 'REGISTER' ? '注册手机号主账号' : '登录账号'}}</view>
    <view wx:if="{{capabilities.wechatMiniProgramEnabled}}" class="wechat-login">
      <button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="loginWithWechat">微信快捷登录</button>
      <view class="muted session-note">登录与当前微信身份已关联的吃什么账号。新用户请先用手机号注册；小程序中的微信账号关联功能尚未接入。</view>
    </view>
    <view class="chips auth-tabs">
      <button wx:if="{{capabilities.phoneEnabled}}" class="chip {{method === 'PHONE' ? 'selected' : ''}}" data-method="PHONE" disabled="{{busy}}" bindtap="changeMethod">手机号</button>
      <button wx:if="{{capabilities.emailEnabled}}" class="chip {{method === 'EMAIL' ? 'selected' : ''}}" data-method="EMAIL" disabled="{{busy}}" bindtap="changeMethod">邮箱</button>
    </view>
    <view wx:if="{{method === 'PHONE' && capabilities.phoneEnabled}}">
      <view wx:if="{{capabilities.registrationEnabled}}" class="chips auth-tabs">
        <button class="chip {{purpose === 'LOGIN' ? 'selected' : ''}}" data-purpose="LOGIN" disabled="{{busy}}" bindtap="changePurpose">已有账号</button>
        <button class="chip {{purpose === 'REGISTER' ? 'selected' : ''}}" data-purpose="REGISTER" disabled="{{busy}}" bindtap="changePurpose">注册新账号</button>
      </view>
      <view class="label">中国大陆手机号</view>
      <input class="field" type="text" maxlength="14" value="{{target}}" placeholder="请输入手机号（支持 +86）" disabled="{{busy}}" bindinput="inputTarget" />
    </view>
    <view wx:if="{{method === 'EMAIL' && capabilities.emailEnabled}}">
      <view class="muted form-tip">邮箱只能登录已绑定的账号。新用户请使用手机号注册。</view>
      <view class="label">已绑定的邮箱</view>
      <input class="field" type="text" maxlength="254" value="{{target}}" placeholder="请输入邮箱地址" disabled="{{busy}}" bindinput="inputTarget" />
    </view>
    <block wx:if="{{(method === 'PHONE' && capabilities.phoneEnabled) || (method === 'EMAIL' && capabilities.emailEnabled)}}">
      <button class="secondary" loading="{{busy}}" disabled="{{busy || resendSeconds > 0}}" bindtap="sendCode">{{resendSeconds > 0 ? resendSeconds + ' 秒后可重发' : '发送验证码'}}</button>
      <view wx:if="{{hasChallenge}}" class="muted form-tip">验证码已发送至 {{maskedTarget}}</view>
      <view class="label">验证码</view>
      <input class="field" type="number" maxlength="6" value="{{otpCode}}" placeholder="6 位验证码" disabled="{{busy || !hasChallenge}}" bindinput="inputCode" />
      <button class="primary" loading="{{busy}}" disabled="{{busy || !hasChallenge}}" bindtap="login">{{purpose === 'REGISTER' ? '验证并注册' : '验证并登录'}}</button>
      <view class="muted session-note">仅在点击后发送验证码。登录状态不写入本地存储，退出小程序后需重新登录。</view>
    </block>
    <view wx:if="{{!capabilities.phoneEnabled && !capabilities.emailEnabled}}" class="empty">当前没有可用的验证码登录方式。</view>
  </view>
  <view wx:else class="card"><view class="section-title">账号服务暂未开放</view><view class="muted">你仍可使用已开放的推荐功能。可在设置中重新检查服务状态。</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{!signedIn && !capabilities.wechatMiniProgramEnabled}}" class="card"><view class="label">微信快捷登录</view><view class="muted">当前服务尚未开放微信小程序登录。可在设置中重新检查服务状态。</view></view>
  <view class="card footer-links"><button class="secondary" bindtap="openPrivacy">隐私说明</button><button class="secondary" bindtap="openSettings">设置</button></view>
</view>
