.toolbar,.record-actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.retention{margin:12px 0 18px}.record .row{align-items:flex-start}.badge{flex-shrink:0;background:var(--accent-soft);color:var(--accent);font-size:12px;border-radius:9px;padding:5px 8px}.address{margin:12px 0;line-height:1.6}.record-actions .chip{font-size:13px;padding:8px 10px}.danger{color:#b43c3c}.theme-dark .danger{color:#ffaaaa}.detail-backdrop{position:fixed;z-index:30;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;padding:18px 18px calc(18px + env(safe-area-inset-bottom))}.detail-sheet{margin:0;width:100%;max-height:80vh;overflow:auto}.detail-sheet .section-title{margin:0}.detail-sheet .row{margin-bottom:18px}
