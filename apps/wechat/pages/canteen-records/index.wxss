.history-eyebrow { font-size:12px; color:var(--muted); margin-bottom:10px; }.canteen-history > .subtitle { margin-bottom:22px; }.remember-copy { font-size:12px; margin-top:10px; }.remember-card switch { flex-shrink:0; }
.empty-records { text-align:center; padding:28px 22px; }.empty-records .muted { margin-top:10px; font-size:13px; }.empty-symbol { width:52px; height:52px; border-radius:18px; background:var(--soft); color:var(--accent); font-size:23px; display:flex; align-items:center; justify-content:center; margin:0 auto 16px; }
.record-time { color:var(--muted); font-size:11px; margin-bottom:10px; }.record-name { font-size:19px; line-height:1.5; font-weight:600; overflow-wrap:anywhere; word-break:break-all; }.record-stall { font-size:14px; color:var(--accent); margin-top:7px; }.record-price { font-size:15px; line-height:25px; margin-top:13px; }.weight-note { font-size:11px; margin-top:5px; }
.reduce-motion button { transition:none; }.reduce-motion button:active { transform:none; }
