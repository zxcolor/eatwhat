.choice-plus { position:absolute; inset:0; opacity:1; transition:opacity 120ms ease; }
.selection-check { display:block; width:18px; flex-shrink:0; color:var(--accent); line-height:24px; text-align:center; opacity:0; transform:scale(.9); transition:opacity 120ms cubic-bezier(0.23,1,0.32,1), transform 120ms cubic-bezier(0.23,1,0.32,1); }
.choice-mark .selection-check { width:100%; line-height:20px; color:inherit; }
