.preference-page { min-height:100vh; padding:52px 20px calc(36px + env(safe-area-inset-bottom)); }
.preference-title { margin:0 auto 42px; max-width:460px; color:var(--text); font-size:34px; font-weight:700; line-height:1.3; letter-spacing:-1px; }
.preference-sliders { display:flex; flex-direction:column; gap:24px; width:100%; max-width:460px; margin:0 auto; }
.preference-sliders taste-slider { display:block; width:100%; }
.preference-error { max-width:460px; margin:20px auto 0; color:var(--accent); font-size:13px; line-height:1.65; }
button.enter-button { display:block; width:100%; max-width:460px; min-height:54px; margin:36px auto 0; padding:15px 22px; border-radius:28px; background:#6b49ef; color:#fff; font-size:16px; line-height:24px; font-weight:600; box-shadow:0 4px 16px rgba(107,73,239,.14); transition:transform 140ms var(--ease-out),opacity 140ms var(--ease-out); animation:enter-appear 180ms var(--ease-out) both; }
button.enter-button-pressed { transform:scale(.98); opacity:.9; }
button.enter-button[disabled] { color:#fff; background:#6b49ef; opacity:.55; }
.theme-dark button.enter-button { background:#9867ff; color:#fff; }
@keyframes enter-appear { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
.reduce-motion button.enter-button { animation:none; transition:none; }.reduce-motion button.enter-button:active { transform:none; }
@media (prefers-reduced-motion:reduce) { button.enter-button { animation:none; transition:none; }button.enter-button:active { transform:none; } }
@media (max-width:350px) { .preference-page { padding-left:16px; padding-right:16px; }.preference-title { font-size:30px; margin-bottom:34px; }.preference-sliders { gap:20px; } }
