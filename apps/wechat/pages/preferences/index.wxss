.selected .choice-mark { background:var(--accent); border-color:var(--accent); color:#fff; }
.theme-dark .selected .choice-mark { color:#211d19; }
.selected .priority-check { background:var(--accent); border-color:var(--accent); color:#fff; }
.theme-dark .selected .priority-check { color:#211d19; }
.preference-pass { margin-top:14px; border:1px solid var(--line); border-radius:20px; overflow:hidden; background:var(--card); }
.pass-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:15px 17px; border-bottom:1px solid var(--line); color:var(--text); font-size:14px; line-height:22px; font-weight:600; }
.pass-status { flex-shrink:0; color:var(--muted); font-size:12px; font-weight:400; }
.summary-list { padding:0 17px; }
.preference-page button.summary-row { width:100%; display:flex; align-items:center; gap:14px; min-height:72px; padding:12px 0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; color:var(--text); text-align:left; }
.preference-page button.summary-row:last-child { border-bottom:0; }
.preference-page button.summary-row-pressed { background:var(--accent-soft); }
.summary-copy { flex:1; min-width:0; }
.summary-label { color:var(--muted); font-size:12px; line-height:18px; }
.summary-value { margin-top:4px; font-size:15px; line-height:1.6; overflow-wrap:break-word; }
.summary-edit { flex-shrink:0; color:var(--accent); font-size:12px; line-height:20px; padding:4px 8px; border:1px solid var(--line); border-radius:8px; }
.readiness { margin-top:20px; padding:15px 16px; border:1px solid var(--line); border-radius:16px; background:var(--soft); }
.readiness-title { display:flex; align-items:center; gap:6px; margin-bottom:6px; font-size:15px; line-height:1.5; font-weight:600; }
.readiness.ready { background:var(--accent-soft); }
.readiness.needs-adjustment { border-color:var(--accent); }
.readiness-title { transition:color 120ms ease; }
.ready .readiness-title, .needs-adjustment .readiness-title { color:var(--accent); }
.ready-check { display:block; width:16px; flex-shrink:0; color:var(--accent); text-align:center; opacity:0; transform:scale(.9); transition:opacity 120ms cubic-bezier(0.23,1,0.32,1), transform 120ms cubic-bezier(0.23,1,0.32,1); }
.ready .ready-check { opacity:1; transform:scale(1); }
.preference-footnote { display:flex; align-items:center; gap:12px; margin-top:20px; }
.preference-footnote .local-note { flex:1; min-width:0; margin-top:0; font-size:11px; }
.preference-actions { position:fixed; z-index:20; left:0; right:0; bottom:0; padding:12px 20px calc(12px + env(safe-area-inset-bottom)); border-top:1px solid var(--line); background:var(--bg); box-shadow:0 -6px 20px rgba(53,44,40,.04); }
.action-context { min-height:20px; margin-bottom:9px; color:var(--muted); font-size:12px; line-height:20px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.action-context.action-error { color:var(--accent); white-space:normal; overflow:visible; }
.action-buttons { display:flex; align-items:stretch; gap:10px; }
.preference-page button.preference-primary { width:100%; min-height:54px; margin-top:14px; padding:15px 12px; background:var(--accent); color:#fff; border-radius:17px; font-size:16px; line-height:24px; font-weight:600; }
.preference-page.theme-dark button.preference-primary { color:#211d19; }
.preference-page button.preference-primary[disabled] { opacity:1; color:var(--muted); background:var(--soft); }
.preference-page .preference-actions button.preference-primary { width:auto; min-width:0; flex:1; margin-top:0; }
.preference-page .review-actions button.preference-primary { border:2px solid var(--accent); padding:13px 12px; }
.preference-page .review-actions button.preference-primary[disabled] { border-color:var(--line); }
.preference-page .review-actions button.preference-confirm-pressed { box-shadow:inset 0 0 0 2px rgba(0,0,0,.1); }
.preference-page button.preference-back { width:88px; flex-shrink:0; min-height:54px; margin:0; padding:15px 10px; border:1px solid var(--line); border-radius:17px; background:var(--card); color:var(--text); font-size:14px; line-height:22px; }
.preference-page button.privacy-link { width:auto; min-height:44px; margin:4px auto 0; padding:12px; background:transparent; color:var(--muted); font-size:12px; line-height:20px; text-decoration:underline; }
.preference-page .preference-footnote button.privacy-link { flex-shrink:0; margin:0; padding:10px 0 10px 4px; font-size:11px; }
.preference-page button.option-pressed { background:var(--accent-soft); }
.preference-page button.preference-primary-pressed { opacity:.86; }
@media (max-width:350px) { .preference-page { padding-left:16px; padding-right:16px; } .preference-actions { padding-left:16px; padding-right:16px; } .preference-title { font-size:24px; } .preference-page button.group-option { padding-left:10px; padding-right:10px; font-size:13px; } .option-section { padding-left:11px; padding-right:11px; } .option-section-heading { gap:6px; } .option-section .option-heading { font-size:14px; } .preference-page button.compact-option { padding-left:8px; padding-right:8px; font-size:12px; } .preference-page .preference-actions button.preference-primary { font-size:14px; } .preference-page button.preference-back { width:76px; } }
@media (prefers-reduced-motion:reduce) {
  .preference-page button.group-option, .preference-page button.none-option, .preference-page button.compact-option, .preference-page button.priority-option, .priority-check, .choice-plus, .selection-check, .readiness-title, .ready-check { transition:none; }
  .selection-check, .selected .selection-check, .ready-check, .ready .ready-check { transform:none; }
}
