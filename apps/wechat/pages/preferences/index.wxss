.progress-step.complete .step-number { background:var(--accent-soft); color:var(--accent); }
.progress-step.current { border-color:var(--accent); color:var(--accent); font-weight:600; }
.progress-step.current .step-number { background:var(--accent); color:#fff; }
.theme-dark .progress-step.current .step-number { color:#211d19; }
.current-choice { margin-top:17px; padding:12px 14px; border:1px solid var(--line); border-radius:13px; background:var(--soft); }
.current-choice.has-choice { background:var(--accent-soft); }
.current-choice-label { display:flex; align-items:center; justify-content:space-between; gap:10px; color:var(--muted); font-size:11px; line-height:18px; }
.multiple-label { flex-shrink:0; color:var(--accent); }
.current-choice-value { margin-top:4px; color:var(--text); font-size:13px; line-height:1.7; }
.group-options { display:flex; flex-wrap:wrap; gap:10px; margin:16px 0 12px; }
.preference-page button.group-option { width:calc((100% - 10px) / 2); min-height:58px; padding:12px; display:flex; align-items:center; justify-content:space-between; gap:8px; background:var(--card); color:var(--text); border:1px solid var(--line); border-radius:14px; text-align:left; font-size:14px; line-height:22px; }
.group-label { flex:1; min-width:0; }
