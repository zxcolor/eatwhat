.preference-page button.compact-option { width:calc((100% - 10px) / 2); flex:0 0 auto; min-height:50px; display:flex; align-items:center; justify-content:space-between; gap:6px; background:var(--card); color:var(--text); border:1px solid var(--line); border-radius:12px; padding:11px 10px; font-size:13px; line-height:24px; }
