.preference-page { --bg:#F7F6F2; --card:#fff; --text:#1C1C1E; --muted:#79766f; --accent:#b94a29; --soft:#efede6; --line:#e7e4db; --accent-soft:#fbefe8; padding:24px 20px calc(28px + env(safe-area-inset-bottom)); }
.preference-page.preference-wizard { padding-bottom:calc(186px + env(safe-area-inset-bottom)); }
