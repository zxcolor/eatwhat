.preference-page button.none-option { width:100%; min-height:50px; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; background:var(--bg); color:var(--muted); border:1px solid var(--line); border-radius:14px; font-size:14px; line-height:22px; }
