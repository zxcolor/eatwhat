<view class="page {{themeClass}}">
  <view class="title">最近决策</view>
  <view class="subtitle">只在本机保存时间与决策摘要，最多 30 条、90 天。不保存位置或餐厅信息。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!entries.length}}" class="empty">暂无最近决策</view>
  <view wx:for="{{entries}}" wx:key="id" class="card record">
    <view class="row"><text class="label">{{item.title}}</text><text class="count">{{item.count}} 个结果</text></view>
    <view class="muted summary">{{item.summary}}</view>
  </view>
  <button wx:if="{{entries.length}}" class="secondary" bindtap="clearRecords">清空最近决策</button>
</view>
