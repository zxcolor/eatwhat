<view wx:if="{{preferenceReady}}" class="page decision-page location-page {{themeClass}}">
  <view class="virtual-badge">虚拟地图</view><view class="title">从哪里出发</view><view class="subtitle">点选街区里的一个地点，就从这里开始。</view>
  <view class="virtual-map" aria-label="虚构街区示意地图">
    <view class="road road-horizontal"/><view class="road road-vertical"/><view class="park"/><view class="block block-one"/><view class="block block-two"/>
    <button wx:for="{{places}}" wx:key="id" class="map-pin {{item.selected ? 'selected' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%;" data-id="{{item.id}}" bindtap="choose"><text wx:if="{{item.selected}}" class="pin-check">✓ </text>{{item.label}}</button>
    <view class="map-caption">虚构街区 · 无需真实定位</view>
  </view>
  <view class="selected-place"><view class="place-check">✓</view><view><view class="selection-caption">已选起点</view><view class="selected-name">{{label}}</view></view></view>
  <view class="card selection"><view class="selection-heading"><view class="label">自选虚拟位置</view><text class="optional-label">可选</text></view><view class="muted coordinate-label">也可以拖动滑杆，调整地图上的坐标。</view>
    <view class="row axis-label"><text>横向位置</text><text>{{x}}</text></view><slider min="0" max="1000" step="10" value="{{x}}" data-key="x" bindchange="coordinate" activeColor="#b94a29" block-size="20"/>
    <view class="row axis-label"><text>纵向位置</text><text>{{y}}</text></view><slider min="0" max="1000" step="10" value="{{y}}" data-key="y" bindchange="coordinate" activeColor="#b94a29" block-size="20"/>
  </view>
  <view class="virtual-note">坐标范围为0–1000，不对应现实位置。更换地点会重新开始本轮决定。</view>
  <view class="location-footer"><view wx:if="{{error}}" class="error">{{error}}</view><view class="footer-choice">已选：{{label}}</view><button class="primary" bindtap="confirm">从这里出发</button></view>
</view>
