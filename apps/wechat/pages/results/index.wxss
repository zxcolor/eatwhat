.decision-page { --bg:#F7F6F2; --card:#fff; --text:#1C1C1E; --muted:#72746e; --accent:#b94a29; --soft:#ecece5; --line:#e1e1d8; --accent-soft:#fff0e9; padding:24px 18px calc(120px + env(safe-area-inset-bottom)); }
.decision-page.theme-dark { --bg:#211d19; --card:#2d2721; --text:#f6eadd; --muted:#c2ad96; --accent:#efaa7c; --soft:#403327; --line:#5b4937; --accent-soft:#483227; }
.page-heading { margin-bottom:22px; }
.virtual-badge { display:inline-block; padding:5px 9px; margin-bottom:12px; background:var(--accent-soft); color:var(--accent); border-radius:7px; font-size:11px; line-height:18px; }
.title { margin-bottom:0; font-size:28px; line-height:1.35; font-weight:650; }
.single-result { position:relative; }
.meal-art { position:relative; height:162px; border-radius:23px; background:#e7e6d8; overflow:hidden; display:flex; align-items:center; justify-content:center; }
.art-ring { position:absolute; width:190px; height:190px; border-radius:50%; background:#d8dcc9; left:-54px; top:-96px; }
.art-plate { position:relative; width:154px; height:106px; border:8px solid #f5ecdd; background:#fffaf1; border-radius:50%; transform:rotate(-10deg); box-shadow:0 6px 0 #c7b191; }
.art-rice { position:absolute; width:75px; height:65px; background:#faf1d8; border-radius:50%; right:2px; top:10px; box-shadow:inset 0 -6px #eadfc3; }
.art-main { position:absolute; width:58px; height:49px; left:5px; top:19px; border-radius:16px; background:#bc753f; transform:rotate(20deg); box-shadow:inset 0 -7px #a75f32; }
.art-greens { position:absolute; width:35px; height:28px; border-radius:50%; background:#738847; left:45px; top:1px; box-shadow:13px 5px #8b9b59,-13px 7px #92a564,6px 16px #657e42; }
.art-caption { position:absolute; left:12px; top:10px; font-size:10px; line-height:16px; color:#686b59; background:#ffffffd9; border-radius:6px; padding:4px 7px; }
.result-body { position:relative; margin:-26px 8px 0; padding:20px 18px 0; border:1px solid var(--line); border-radius:20px; background:var(--card); box-shadow:0 6px 18px rgba(53,44,40,.04); }
.pick-row { display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:9px; }
.pick-label { font-size:11px; line-height:18px; color:var(--muted); }
.chosen-label { flex-shrink:0; color:var(--accent); font-size:11px; font-weight:600; }
.result-name { font-size:25px; line-height:1.35; font-weight:650; overflow-wrap:break-word; }
.restaurant { color:var(--muted); font-size:13px; line-height:1.7; margin-top:6px; }
.result-facts { display:flex; gap:18px; padding:17px 0; margin-top:16px; border-top:1px solid var(--line); }
.fact { flex:1; min-width:0; }
.fact-label { color:var(--muted); font-size:10px; line-height:16px; margin-bottom:5px; }
.price { font-size:26px; font-weight:650; line-height:1.3; overflow-wrap:break-word; }
.distance-fact { padding-left:18px; border-left:1px solid var(--line); }
.distance { color:var(--text); font-size:14px; line-height:22px; font-weight:600; padding-top:4px; overflow-wrap:break-word; }
.brief-reason { display:flex; gap:7px; font-size:12px; color:var(--text); line-height:1.8; }
.reason-mark { flex-shrink:0; color:var(--accent); font-weight:700; }
.unknown-summary { padding:8px 0 12px; }
.uncertainty { font-size:11px; color:var(--muted); line-height:1.8; }
.detail-link { display:flex; justify-content:space-between; align-items:center; gap:12px; width:100%; min-height:46px; padding:12px 0; border-top:1px solid var(--line); border-radius:0; background:transparent; color:var(--accent); font-size:12px; text-align:left; }
.confirmation { margin:18px 8px 0; padding:14px 16px; border-radius:14px; background:var(--accent-soft); color:var(--text); font-size:12px; line-height:1.8; }
.confirmation-title { font-weight:600; margin-bottom:3px; }
.decision-context { padding:17px 8px 0; }
.context-row { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.context-location,.context-adjust { min-height:44px; padding:7px 0; border-radius:8px; background:transparent; color:var(--text); font-size:12px; line-height:21px; text-align:left; }
.context-location { flex:1; min-width:0; }
.context-adjust { color:var(--accent); flex-shrink:0; }
.context-label { display:block; color:var(--muted); font-size:10px; line-height:17px; }
.condition-summary { font-size:11px; color:var(--muted); margin:3px 0 14px; line-height:1.8; }
.why-section { margin:0 8px; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
.why-toggle { display:flex; justify-content:space-between; align-items:center; width:100%; min-height:48px; padding:12px 0; background:transparent; color:var(--text); font-size:12px; text-align:left; }
.toggle-mark { color:var(--muted); font-size:18px; }
.why-content { padding:0 0 16px; font-size:12px; line-height:1.8; color:var(--muted); }
.why-label { margin:12px 0 8px; color:var(--text); font-size:12px; font-weight:600; }
.why-label:first-child { margin-top:0; }
.why-line+.why-line { margin-top:6px; }
.why-footnote { margin-top:12px; padding:12px 14px; border-radius:12px; background:var(--soft); font-size:11px; }
.strategy-row { padding-top:15px; text-align:center; }
.strategy-label { color:var(--muted); font-size:10px; line-height:16px; }
.strategy-options { display:flex; justify-content:center; align-items:center; gap:8px; color:var(--line); }
.strategy-options button { min-height:44px; padding:10px 7px; font-size:12px; background:transparent; color:var(--muted); }
.result-actions { position:fixed; left:0; right:0; bottom:0; z-index:5; display:flex; gap:10px; padding:14px 22px calc(14px + env(safe-area-inset-bottom)); border-top:1px solid var(--line); background:var(--bg); }
.result-actions .primary,.result-actions .secondary { width:auto; height:52px; min-height:52px; margin:0; padding:14px 15px; border-radius:16px; font-size:16px; line-height:24px; }
.result-actions .primary { flex:1; }
.result-actions .secondary { width:108px; flex-shrink:0; }
.decision-page.theme-dark .primary { color:#211d19; }
.decision-empty { padding:28px 8px 4px; text-align:center; }
.empty-mark { margin:0 auto 20px; width:68px; height:68px; border-radius:23px; background:var(--soft); color:var(--accent); font-size:30px; line-height:68px; }
.empty-eyebrow { margin-bottom:8px; color:var(--muted); font-size:11px; line-height:18px; }
.empty-title { color:var(--text); font-size:25px; line-height:1.4; font-weight:650; }
.empty-copy { margin-top:12px; color:var(--muted); font-size:13px; line-height:1.8; }
.empty-unknowns { padding:12px 14px; margin-top:20px; border-radius:12px; background:var(--soft); text-align:left; }
.empty-context { margin-top:26px; padding:16px 0 0; border-top:1px solid var(--line); text-align:left; }
.empty-context .condition-summary { margin-bottom:3px; }
.decision-empty .primary { margin-top:22px; }
.virtual-note { margin:22px 8px 0; color:var(--muted); font-size:10px; line-height:1.85; }
.primary-pressed { opacity:.82; }
.secondary-pressed,.quiet-pressed { background:var(--accent-soft); }
