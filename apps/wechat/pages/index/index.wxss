.shell { padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
.decision-shell { --bg:#F7F6F2; --card:#fff; --text:#1C1C1E; --muted:#79766f; --accent:#b94a29; --soft:#efede6; --line:#e7e4db; --accent-soft:#fbefe8; }
.decision-shell.theme-dark { --bg:#211d19; --card:#2d2721; --text:#f6eadd; --muted:#c2ad96; --accent:#efaa7c; --soft:#403327; --line:#5b4937; --accent-soft:#483227; }
.target-switch { display:flex; background:var(--soft); border:1px solid var(--line); border-radius:18px; padding:4px; margin:16px 0 12px; }
.target-option { flex:1; background:transparent; color:var(--muted); font-size:14px; min-height:44px; line-height:44px; padding:0 8px; border-radius:14px; }
.target-option.selected { color:var(--text); background:var(--card); font-weight:600; box-shadow:0 2px 5px rgba(53,44,40,.05); }
.home-content { padding:28px 20px 20px; }
.home-eyebrow { display:flex; align-items:center; gap:6px; color:var(--muted); font-size:12px; letter-spacing:.5px; margin-bottom:12px; }
.eyebrow-dot { width:5px; height:5px; border-radius:50%; background:var(--accent); }
.home-title { font-size:30px; line-height:40px; font-weight:700; letter-spacing:-.5px; }
button.location { width:100%; display:flex; align-items:center; justify-content:flex-start; gap:9px; background:transparent; color:var(--muted); padding:0; min-height:44px; text-align:left; margin:0; font-size:14px; }
.location-icon { width:20px; height:20px; }
.location-current { max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; color:var(--muted); padding-left:10px; border-left:1px solid var(--line); }
.chevron { width:12px; height:12px; flex-shrink:0; margin-left:0; }
button.decision-card { position:relative; overflow:hidden; width:100%; min-height:190px; border:1px solid var(--line); border-radius:28px; padding:16px 20px 18px; display:flex; align-items:center; flex-direction:column; background:var(--card); color:var(--text); box-shadow:0 6px 22px rgba(53,44,40,.04); transition:transform 150ms cubic-bezier(.23,1,.32,1),background-color 150ms ease,box-shadow 150ms ease; }
.decision-card-top { width:100%; display:flex; align-items:center; justify-content:space-between; gap:8px; color:var(--muted); font-size:11px; line-height:22px; }
.personalized-label { color:var(--accent); background:var(--accent-soft); padding:1px 8px; border-radius:20px; }
.decision-card-main { display:flex; width:100%; align-items:center; gap:12px; margin:16px 0; text-align:left; }
.decision-copy { flex:1; min-width:0; }.decision-copy text { display:block; }
.dice-orbit { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:70px; height:70px; border-radius:22px; background:var(--soft); }
button.decision-card-pressed { transform:scale(.98); background:var(--accent-soft); }
button.decision-card[disabled] { background:var(--card); color:var(--text); opacity:1; }
.decision-card[disabled] .decision-title { opacity:.5; }
.dice { width:52px; height:52px; }
.decision-title { font-size:27px; font-weight:700; line-height:34px; letter-spacing:-.5px; }
.decision-subtitle { margin-top:6px; font-size:14px; line-height:23px; color:var(--muted); }
.decision-start { width:100%; display:flex; align-items:center; justify-content:center; gap:16px; background:var(--accent); color:#fff; border-radius:28px; padding:12px 16px; font-size:15px; font-weight:600; }
.start-arrow { font-size:20px; font-weight:400; line-height:20px; }
.decision-help { display:flex; align-items:center; justify-content:center; gap:7px; margin-top:13px; color:var(--muted); font-size:11px; }
.help-check { color:var(--accent); }
.home-caption { margin-top:10px; text-align:center; color:var(--muted); font-size:10px; line-height:18px; }
.consent-card { margin:12px 0; padding:18px; border:1px solid var(--line); border-radius:18px; background:var(--soft); }
.consent-copy { margin-top:8px; }
.policy-link { display:inline-block; font-size:14px; margin-top:10px; padding:4px 0; }
.tab-content { padding:28px 20px; }
.tab-intro { margin-top:8px; color:var(--muted); font-size:13px; line-height:22px; }
.records-card { margin-top:24px; text-align:center; padding:28px 22px 22px; }
.record-icon-wrap { display:flex; align-items:center; justify-content:center; background:var(--soft); width:60px; height:60px; border-radius:20px; margin:0 auto 16px; }
.empty-icon { width:28px; height:28px; opacity:.7; }
.record-title { font-size:19px; font-weight:600; margin-bottom:8px; }
.section-heading { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px; }
.status-chip { font-size:10px; padding:3px 7px; border-radius:6px; color:var(--muted); background:var(--soft); }
.page-footnote { text-align:center; font-size:11px; color:var(--muted); line-height:20px; padding:12px 12px 0; }
.personal-title { margin-bottom:20px; }
.group-label { font-size:12px; font-weight:600; color:var(--muted); margin:24px 0 10px 3px; }
.menu-group { border:1px solid var(--line); border-radius:20px; overflow:hidden; }
button.personal-card { width:100%; padding:17px 16px; border-radius:0; background:var(--card); color:var(--text); display:flex; align-items:center; gap:14px; text-align:left; line-height:1.4; }
.menu-group .personal-card + .personal-card { border-top:1px solid var(--line); }
button.taste-card { border:1px solid var(--line); border-radius:22px; padding:22px 18px; }
.taste-monogram { flex-shrink:0; display:flex; align-items:center; justify-content:center; width:50px; height:50px; border-radius:17px; color:var(--accent); background:var(--accent-soft); font-size:24px; }
.taste-caption { color:var(--accent); font-size:10px; margin-bottom:7px; }
.taste-card .label { font-size:20px; }
.personal-icon { width:22px; height:22px; flex-shrink:0; }
.personal-text { flex:1; }
.personal-text .muted { margin-top:5px; font-size:12px; line-height:18px; }
.arrow { font-size:25px; color:var(--muted); }
.dock-wrap { position:fixed; left:0; right:0; bottom:0; padding:10px 22px calc(10px + env(safe-area-inset-bottom)); background:linear-gradient(transparent,var(--bg)); z-index:10; }
.dock { display:flex; position:relative; border:1px solid var(--line); background:var(--card); border-radius:32px; padding:5px; box-shadow:0 6px 24px rgba(53,44,40,.09); }
.dock-highlight { position:absolute; left:5px; top:5px; bottom:5px; width:calc((100% - 10px) / 3); border-radius:28px; background:var(--accent-soft); transition:transform 260ms cubic-bezier(.23,1,.32,1); }
.dock-item { flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; min-height:54px; padding:7px 0; background:transparent; color:var(--muted); font-size:11px; line-height:16px; z-index:1; }
.dock-item.active { color:var(--accent); }
.dock-icon { width:23px; height:23px; }
.theme-dark .decision-start { color:#352c28; }
.theme-dark .dock-item.active .dock-icon { filter:brightness(1.7); }
.theme-dark .personal-icon, .theme-dark .location-icon, .theme-dark .chevron, .theme-dark .dock-item:not(.active) .dock-icon { opacity:.85; filter:invert(1); }
.filter-entry { display:flex; align-items:center; gap:10px; width:100%; min-height:64px; margin-bottom:14px; padding:10px 12px; background:var(--card); border:1px solid var(--line); border-radius:20px; color:var(--text); text-align:left; transition:transform 150ms cubic-bezier(.23,1,.32,1); }
.filter-symbol { width:34px; height:34px; display:flex; align-items:center; justify-content:center; background:var(--soft); border-radius:12px; flex-shrink:0; }.filter-symbol image { width:18px; height:18px; }
.filter-entry-copy { flex:1; min-width:0; }.filter-entry-copy text { display:block; }.filter-entry-title { font-size:13px; font-weight:600; }.filter-summary { margin-top:3px; font-size:11px; line-height:17px; color:var(--muted); }.filter-change { font-size:12px; color:var(--accent); flex-shrink:0; }
.tap-ripple { position:absolute; width:500px; height:500px; margin:-250px; border-radius:50%; pointer-events:none; background:rgba(185,74,41,.1); animation:tap-spread 320ms cubic-bezier(.23,1,.32,1) both; }
@keyframes tap-spread { from { transform:scale(.08); opacity:.9; } to { transform:scale(1); opacity:0; } }
.candidate-section { margin-top:28px; }.candidate-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }.candidate-heading > view { display:flex; flex-direction:column; gap:5px; }.candidate-title { font-size:17px; font-weight:600; }.candidate-count { font-size:11px; color:var(--muted); }
.compare-toggle { margin:0; min-height:44px; padding:12px 0 12px 14px; background:transparent; color:var(--accent); font-size:12px; }.preview-stack { position:relative; padding-bottom:7px; }.stack-back { position:absolute; left:10px; right:10px; top:10px; height:140px; background:var(--card); border:1px solid var(--line); border-radius:22px; }.stack-back-far { top:18px; left:20px; right:20px; opacity:.65; }
.candidate-swiper { height:144px; }.preview-card,.compare-card { width:100%; display:flex; align-items:center; gap:12px; text-align:left; height:138px; padding:14px; background:var(--card); color:var(--text); border:1px solid var(--line); border-radius:22px; overflow:hidden; }.preview-card { transition:transform 150ms cubic-bezier(.23,1,.32,1); }.preview-illustration { width:78px; height:88px; border-radius:18px; flex-shrink:0; overflow:hidden; background:var(--soft); }.preview-illustration image { width:100%; height:100%; }.preview-copy,.compare-copy { flex:1; min-width:0; }.preview-copy > text,.compare-copy > text { display:block; }.preview-name { font-size:14px; font-weight:600; line-height:20px; overflow:hidden; text-overflow:ellipsis; display:-webkit-box!important; -webkit-line-clamp:2; -webkit-box-orient:vertical; }.preview-store { margin-top:4px; font-size:10px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.preview-meta { display:flex; align-items:center; justify-content:space-between; gap:6px; margin-top:8px; font-size:10px; color:var(--muted); }.preview-meta > text:first-child { color:var(--accent); font-size:15px; font-weight:600; }.opening-unknown { color:var(--muted); font-size:9px; margin-top:5px; }.preview-pagination { margin-top:12px; display:flex; justify-content:space-between; font-size:10px; color:var(--muted); }.compare-card { margin-bottom:10px; height:auto; min-height:138px; }.preview-empty { padding:22px; border:1px dashed var(--line); border-radius:22px; color:var(--muted); font-size:13px; line-height:22px; text-align:center; }
.press-soft { transform:scale(.98); }.theme-dark .filter-symbol image { filter:invert(1); }
button.filter-entry,button.preview-card { width:100%; margin-left:0; margin-right:0; }
button.compare-toggle { width:auto; }
.motion-reduced .dock-highlight,.motion-reduced button { transition:none; }.motion-reduced button:active,.motion-reduced .decision-card-pressed,.motion-reduced .press-soft { transform:none; }
@media (prefers-reduced-motion: reduce) { .dock-highlight,button.decision-card,.filter-entry,.preview-card { transition:none; } .tap-ripple { display:none; } button.decision-card-pressed,.press-soft { transform:none; } }
