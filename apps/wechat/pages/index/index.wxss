.shell { padding-bottom:calc(110px + env(safe-area-inset-bottom)); }
.home-content { padding:28px 18px; }
.home-title { font-size:32px; line-height:40px; font-weight:700; letter-spacing:-.5px; }
.location { display:flex; align-items:center; gap:9px; background:transparent; color:var(--muted); padding:8px 0; min-height:48px; text-align:left; margin:4px 0 8px; font-size:16px; }
.location-icon { width:20px; height:20px; }
.chevron { margin-left:1px; font-size:19px; }
button.decision-card { width:100%; min-height:214px; border-radius:28px; padding:28px 24px; display:flex; align-items:center; flex-direction:column; gap:14px; background:var(--card); color:var(--text); }
button.decision-card[disabled] { background:var(--card); color:var(--text); opacity:1; }
.decision-card[disabled] .decision-title { opacity:.5; }
.dice { width:56px; height:56px; }
.decision-title { font-size:22px; font-weight:700; line-height:30px; }
.decision-subtitle { font-size:16px; line-height:25px; color:var(--muted); }
.consent-card { margin:12px 0 18px; padding:20px; border-radius:20px; background:var(--card); }
.consent-copy { margin-top:8px; }
.policy-link { display:inline-block; font-size:14px; margin-top:10px; padding:4px 0; }
.tab-content { padding:28px 16px; }
.records-card { margin-top:24px; text-align:center; padding:32px 20px; }
.empty-icon { width:42px; height:42px; opacity:.5; }
.personal-title { margin-bottom:24px; }
button.personal-card { width:100%; padding:20px; border-radius:20px; background:var(--card); color:var(--text); display:flex; align-items:center; gap:16px; margin-bottom:14px; text-align:left; }
.personal-icon { width:26px; height:26px; flex-shrink:0; }
.personal-text { flex:1; }
.personal-text .muted { margin-top:4px; }
.arrow { font-size:25px; color:var(--muted); }
.dock-wrap { position:fixed; left:0; right:0; bottom:0; padding:10px 16px calc(10px + env(safe-area-inset-bottom)); background:var(--bg); z-index:10; }
.dock { display:flex; position:relative; border:.7px solid var(--line); background:var(--card); border-radius:50px; padding:5px; }
.dock-highlight { position:absolute; left:5px; top:5px; bottom:5px; width:calc((100% - 10px) / 3); border-radius:50px; background:var(--soft); transition:transform 180ms cubic-bezier(.77,0,.175,1); }
.dock-item { flex:1; display:flex; flex-direction:column; align-items:center; gap:2px; min-height:62px; padding:7px 0; background:transparent; color:var(--text); font-size:14px; line-height:20px; z-index:1; }
.dock-item.active { color:var(--accent); }
.dock-icon { width:28px; height:28px; }
.theme-dark .personal-icon, .theme-dark .location-icon, .theme-dark .dock-item:not(.active) .dock-icon { opacity:.85; filter:invert(1); }
@media (prefers-reduced-motion: reduce) { .dock-highlight { transition:none; } }
