# Copy to deployment.env, replace every example value, then set mode 0600.
# This file contains deployment coordinates only, never credentials or keys.
# Runtime secrets belong in the three separate root-owned files referenced by
# compose.yml and must not be committed.

COMPOSE_PROJECT_NAME=chi-shen-me-alpha

# Persistent credentials are shared by every immutable release and must never
# be regenerated while the PostgreSQL volume is retained.
SHARED_STATE_DIRECTORY=/opt/chi-shen-me/shared

# BaoTa Nginx owns public ports 80/443 and proxies to this loopback-only port.
API_LOOPBACK_PORT=13001

# The readable tag is paired with the exact locally loaded image ID. The strict
# preflight refuses a tag that resolves to any other bytes, including when an
# offline tar archive has no RepoDigest.
API_IMAGE=registry.example.invalid/chi-shen-me/api:replace-me
API_IMAGE_ID=sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
POSTGIS_IMAGE_ID=sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

POSTGRES_DB=chi_shen_me
POSTGRES_BOOTSTRAP_USER=postgres_bootstrap
POSTGRES_VOLUME_NAME=chi-shen-me-alpha_postgres_data

# Must match an actually released Android version; the API enforces this gate.
MINIMUM_SUPPORTED_VERSION=0.1.1

# Keep false until the root-only api.env contains the AMap key/signing secret
# and the ECS public IP is present in the AMap service-side allowlist.
AMAP_ENABLED=false

# 账号能力默认关闭。开启时必须同时打开 WECHAT_AUTH_ENABLED，并在手机号短信
# 与融合认证中至少打开一个；对应私有值写入 root:root 0600 的 api.env。
ACCOUNTS_ENABLED=false
PHONE_AUTH_ENABLED=false
FUSION_AUTH_ENABLED=false
WECHAT_AUTH_ENABLED=false

# 绑定到 ECS 实例的最小权限 RAM 角色名称。只有手机号短信或融合认证开启时
# 才会使用；不得改成长期 AccessKey。
ALIBABA_CLOUD_ECS_METADATA=replace-with-ram-role-name

# The cleanup service is non-destructive by default. Change to --execute only
# for an explicitly reviewed maintenance invocation.
RETENTION_MODE=--dry-run
